# TMS320C54x SLEIGH specification -- generated by make_slaspec.py, do not edit by hand.

define endian=big;
define alignment=2;

define space prog     type=ram_space      size=2 wordsize=2 default;
define space data     type=ram_space      size=2 wordsize=2;
define space io       type=ram_space      size=2 wordsize=2;
define space register type=register_space size=2;

define register offset=0x00 size=2 [ PC SP T TRN AR0 AR1 AR2 AR3 AR4 AR5 AR6 AR7
                                     BK BRC RSA REA PMST XPC IMR IFR ST0 ST1 DP RC ];
define register offset=0x40 size=8 [ A B ];
define register offset=0x42 size=2 [ AG ];
define register offset=0x44 size=2 [ AH AL ];
define register offset=0x4A size=2 [ BG ];
define register offset=0x4C size=2 [ BH BL ];
define register offset=0x80 size=1 [ TC C OVA OVB SXM OVM C16 FRCT CPL INTM XF BRAF CMPT HM ARP ASM BIO ];   # BIO: the BIO input pin
define register offset=0x100 size=4 [ contextreg ];

define context contextreg
  cplmode = (0,0)      # 1: direct addressing is SP-relative (ST1.CPL=1)
;

define token instr(16)
  op16 = (0,15)
  op13 = (3,15)
  op12 = (4,15)
  op11 = (5,15)
  op10 = (6,15)
  op8  = (8,15)
  op7  = (9,15)
  op6  = (10,15)
  op6b = (0,5)
  b7_0 = (0,7)
  lo8  = (0,7)
  b5_4 = (4,5)
  nib1 = (4,7)
  b7_5 = (5,7)
  b7_3 = (3,7)
  b8   = (8,8)
  ind  = (7,7)
  mod  = (3,6)
  arf  = (0,2)
  dma  = (0,6)
  mmr7 = (0,6)
  src9 = (9,9)
  dst8 = (8,8)
  src1 = (8,8)
  shift5 = (0,4) signed
  shft4 = (0,3)
  k8s  = (0,7) signed
  k8u  = (0,7)
  k9   = (0,8)
  k5s  = (0,4) signed
  k5u  = (0,4)
  k3   = (0,2)
  xmod = (6,7)
  xar  = (4,5)
  ymod = (2,3)
  yar  = (0,1)
  cc8  = (0,7)
  cc4  = (0,3)
  cc3  = (8,9)
  nbit = (9,9)
  sbit = (0,3)
  xcn  = (9,9)
  mmrx = (4,7)
  mmry = (0,3)
  idlek = (8,9)
  bitc = (0,3)
  xpage = (0,6)
;

define token ext(16)
  ext16  = (0,15)
  ext16s = (0,15) signed
  e_top6 = (10,15)
  e_src  = (9,9)
  e_dst  = (8,8)
  e_sub  = (5,7)
  e_shift = (0,4) signed
;

attach variables [ arf ] [ AR0 AR1 AR2 AR3 AR4 AR5 AR6 AR7 ];
attach variables [ xar yar ] [ AR2 AR3 AR4 AR5 ];
attach variables [ src9 dst8 src1 e_src e_dst ] [ A B ];

define pcodeop firs;
define pcodeop lms;
define pcodeop abdst;
define pcodeop sqdst;
define pcodeop poly;
define pcodeop exponent;
define pcodeop normalize;
define pcodeop roundAcc;
define pcodeop saturate;
define pcodeop idle;
define pcodeop softwareInterrupt;
define pcodeop softwareReset;
define pcodeop emulationStop;
define pcodeop dataDelay;
define pcodeop compareSelect;
define pcodeop setStatusField;
define pcodeop clearStatusField;
define pcodeop farAddress;

# ---- helpers ---------------------------------------------------------------------------

macro sx40(r) { r = (r << 24) s>> 24; }
macro ashift(v, s) {
  local pos:1 = s s>= 0;
  local amt:8 = sext(s);
  v = (zext(pos) * (v << amt)) + (zext(!pos) * (v s>> (-amt)));
}
macro push(v) { SP = SP - 1; *[data]:2 SP = v; }
macro pop(v)  { v = *[data]:2 SP; SP = SP + 1; }
macro setAccFlags(r) { C = carry(r, 0); }


# Smem: single data-memory operand (direct, indirect, or long-offset indirect)
SmemS: "@"^dma          is ind=0 & dma & cplmode=0 { local a:2 = (DP << 7) | dma; export *[data]:2 a; }
SmemS: "*SP("^dma^")"   is ind=0 & dma & cplmode=1 { local a:2 = SP + dma; export *[data]:2 a; }
SmemS: "*"^arf          is ind=1 & mod=0 & arf { export *[data]:2 arf; }
SmemS: "*"^arf^"-"      is ind=1 & mod=1 & arf { local a:2 = arf; arf = arf - 1; export *[data]:2 a; }
SmemS: "*"^arf^"+"      is ind=1 & mod=2 & arf { local a:2 = arf; arf = arf + 1; export *[data]:2 a; }
SmemS: "*+"^arf         is ind=1 & mod=3 & arf { arf = arf + 1; export *[data]:2 arf; }
SmemS: "*"^arf^"-0B"    is ind=1 & mod=4 & arf { local a:2 = arf; arf = arf - AR0; export *[data]:2 a; }  # bit-reversed, approximated
SmemS: "*"^arf^"-0"     is ind=1 & mod=5 & arf { local a:2 = arf; arf = arf - AR0; export *[data]:2 a; }
SmemS: "*"^arf^"+0"     is ind=1 & mod=6 & arf { local a:2 = arf; arf = arf + AR0; export *[data]:2 a; }
SmemS: "*"^arf^"+0B"    is ind=1 & mod=7 & arf { local a:2 = arf; arf = arf + AR0; export *[data]:2 a; }  # bit-reversed, approximated
SmemS: "*"^arf^"-%"     is ind=1 & mod=8 & arf { local a:2 = arf; arf = arf - 1; export *[data]:2 a; }    # circular, approximated
SmemS: "*"^arf^"-0%"    is ind=1 & mod=9 & arf { local a:2 = arf; arf = arf - AR0; export *[data]:2 a; }  # circular, approximated
SmemS: "*"^arf^"+%"     is ind=1 & mod=10 & arf { local a:2 = arf; arf = arf + 1; export *[data]:2 a; }   # circular, approximated
SmemS: "*"^arf^"+0%"    is ind=1 & mod=11 & arf { local a:2 = arf; arf = arf + AR0; export *[data]:2 a; } # circular, approximated
SmemL: "*"^arf^"("^ext16^")"   is (ind=1 & mod=12 & arf) ; ext16 { local a:2 = arf + ext16; export *[data]:2 a; }
SmemL: "*+"^arf^"("^ext16^")"  is (ind=1 & mod=13 & arf) ; ext16 { arf = arf + ext16; export *[data]:2 arf; }
SmemL: "*+"^arf^"("^ext16^")%" is (ind=1 & mod=14 & arf) ; ext16 { arf = arf + ext16; export *[data]:2 arf; }  # circular, approximated
SmemL: "*("^ext16^")"          is (ind=1 & mod=15) ; ext16 { export *[data]:2 ext16; }
Smem: SmemS is SmemS { export SmemS; }
Smem: SmemL is SmemL { export SmemL; }

# Lmem: 32-bit operand (even address high word); same addressing, steps of 2
Lmem: "@"^dma          is ind=0 & dma & cplmode=0 { local a:2 = (DP << 7) | dma; export *[data]:4 a; }
Lmem: "*SP("^dma^")"   is ind=0 & dma & cplmode=1 { local a:2 = SP + dma; export *[data]:4 a; }
Lmem: "*"^arf          is ind=1 & mod=0 & arf { export *[data]:4 arf; }
Lmem: "*"^arf^"-"      is ind=1 & mod=1 & arf { local a:2 = arf; arf = arf - 2; export *[data]:4 a; }
Lmem: "*"^arf^"+"      is ind=1 & mod=2 & arf { local a:2 = arf; arf = arf + 2; export *[data]:4 a; }
Lmem: "*+"^arf         is ind=1 & mod=3 & arf { arf = arf + 2; export *[data]:4 arf; }
Lmem: "*"^arf^"-0B"    is ind=1 & mod=4 & arf { local a:2 = arf; arf = arf - AR0; export *[data]:4 a; }
Lmem: "*"^arf^"-0"     is ind=1 & mod=5 & arf { local a:2 = arf; arf = arf - AR0; export *[data]:4 a; }
Lmem: "*"^arf^"+0"     is ind=1 & mod=6 & arf { local a:2 = arf; arf = arf + AR0; export *[data]:4 a; }
Lmem: "*"^arf^"+0B"    is ind=1 & mod=7 & arf { local a:2 = arf; arf = arf + AR0; export *[data]:4 a; }
Lmem: "*"^arf^"-%"     is ind=1 & mod=8 & arf { local a:2 = arf; arf = arf - 2; export *[data]:4 a; }
Lmem: "*"^arf^"-0%"    is ind=1 & mod=9 & arf { local a:2 = arf; arf = arf - AR0; export *[data]:4 a; }
Lmem: "*"^arf^"+%"     is ind=1 & mod=10 & arf { local a:2 = arf; arf = arf + 2; export *[data]:4 a; }
Lmem: "*"^arf^"+0%"    is ind=1 & mod=11 & arf { local a:2 = arf; arf = arf + AR0; export *[data]:4 a; }
Lmem: "*"^arf^"("^ext16^")"   is (ind=1 & mod=12 & arf) ; ext16 { local a:2 = arf + ext16; export *[data]:4 a; }
Lmem: "*+"^arf^"("^ext16^")"  is (ind=1 & mod=13 & arf) ; ext16 { arf = arf + ext16; export *[data]:4 arf; }
Lmem: "*+"^arf^"("^ext16^")%" is (ind=1 & mod=14 & arf) ; ext16 { arf = arf + ext16; export *[data]:4 arf; }
Lmem: "*("^ext16^")"          is (ind=1 & mod=15) ; ext16 { export *[data]:4 ext16; }

# Sind: indirect operand of BANZ. BANZ tests ARx as it was before this instruction's update;
# SindS covers the one-word modes, SindL the long-offset modes (one extra word, before pmad).
SindS: "*"^arf          is ind=1 & mod=0 & arf { local v:2 = arf; export v; }
SindS: "*"^arf^"-"      is ind=1 & mod=1 & arf { local v:2 = arf; arf = arf - 1; export v; }
SindS: "*"^arf^"+"      is ind=1 & mod=2 & arf { local v:2 = arf; arf = arf + 1; export v; }
SindS: "*+"^arf         is ind=1 & mod=3 & arf { local v:2 = arf; arf = arf + 1; export v; }
SindS: "*"^arf^"-0B"    is ind=1 & mod=4 & arf { local v:2 = arf; arf = arf - AR0; export v; }
SindS: "*"^arf^"-0"     is ind=1 & mod=5 & arf { local v:2 = arf; arf = arf - AR0; export v; }
SindS: "*"^arf^"+0"     is ind=1 & mod=6 & arf { local v:2 = arf; arf = arf + AR0; export v; }
SindS: "*"^arf^"+0B"    is ind=1 & mod=7 & arf { local v:2 = arf; arf = arf + AR0; export v; }
SindS: "*"^arf^"-%"     is ind=1 & mod=8 & arf { local v:2 = arf; arf = arf - 1; export v; }
SindS: "*"^arf^"-0%"    is ind=1 & mod=9 & arf { local v:2 = arf; arf = arf - AR0; export v; }
SindS: "*"^arf^"+%"     is ind=1 & mod=10 & arf { local v:2 = arf; arf = arf + 1; export v; }
SindS: "*"^arf^"+0%"    is ind=1 & mod=11 & arf { local v:2 = arf; arf = arf + AR0; export v; }
SindL: "*"^arf^"("^ext16s^")"   is (ind=1 & mod=12 & arf) ; ext16s { local v:2 = arf; export v; }
SindL: "*+"^arf^"("^ext16s^")"  is (ind=1 & mod=13 & arf) ; ext16s { local v:2 = arf; arf = arf + ext16s; export v; }
SindL: "*+"^arf^"("^ext16s^")%" is (ind=1 & mod=14 & arf) ; ext16s { local v:2 = arf; arf = arf + ext16s; export v; }

# Xmem / Ymem: dual-operand indirect (AR2-AR5)
Xmem: "*"^xar          is xmod=0 & xar { export *[data]:2 xar; }
Xmem: "*"^xar^"-"      is xmod=1 & xar { local a:2 = xar; xar = xar - 1; export *[data]:2 a; }
Xmem: "*"^xar^"+"      is xmod=2 & xar { local a:2 = xar; xar = xar + 1; export *[data]:2 a; }
Xmem: "*"^xar^"+0%"    is xmod=3 & xar { local a:2 = xar; xar = xar + AR0; export *[data]:2 a; }  # circular, approximated
Ymem: "*"^yar          is ymod=0 & yar { export *[data]:2 yar; }
Ymem: "*"^yar^"-"      is ymod=1 & yar { local a:2 = yar; yar = yar - 1; export *[data]:2 a; }
Ymem: "*"^yar^"+"      is ymod=2 & yar { local a:2 = yar; yar = yar + 1; export *[data]:2 a; }
Ymem: "*"^yar^"+0%"    is ymod=3 & yar { local a:2 = yar; yar = yar + AR0; export *[data]:2 a; }  # circular, approximated

# Immediates and addresses in the extension word
lk:   "#"^ext16  is ext16  { export *[const]:2 ext16; }
lks:  "#"^ext16s is ext16s { export *[const]:2 ext16s; }
dmad: ext16      is ext16  { export *[data]:2 ext16; }
pmad: ext16      is ext16  { export *[prog]:2 ext16; }
pa:   "PA"^ext16 is ext16  { export *[io]:2 ext16; }
target: ext16    is ext16 { export *[prog]:2 ext16; }
xtarget: ext16   is xpage ; ext16 { export *[prog]:2 ext16; }  # far: the 7-bit page (xpage) is not modelled


# MMR: memory-mapped register operand (CPU registers map to Ghidra registers)
mmr: "IMR" is mmr7=0x00 { export IMR; }
mmr: "IFR" is mmr7=0x01 { export IFR; }
mmr: "ST0" is mmr7=0x06 { export ST0; }
mmr: "ST1" is mmr7=0x07 { export ST1; }
mmr: "AL" is mmr7=0x08 { export AL; }
mmr: "AH" is mmr7=0x09 { export AH; }
mmr: "AG" is mmr7=0x0a { export AG; }
mmr: "BL" is mmr7=0x0b { export BL; }
mmr: "BH" is mmr7=0x0c { export BH; }
mmr: "BG" is mmr7=0x0d { export BG; }
mmr: "T" is mmr7=0x0e { export T; }
mmr: "TRN" is mmr7=0x0f { export TRN; }
mmr: "AR0" is mmr7=0x10 { export AR0; }
mmr: "AR1" is mmr7=0x11 { export AR1; }
mmr: "AR2" is mmr7=0x12 { export AR2; }
mmr: "AR3" is mmr7=0x13 { export AR3; }
mmr: "AR4" is mmr7=0x14 { export AR4; }
mmr: "AR5" is mmr7=0x15 { export AR5; }
mmr: "AR6" is mmr7=0x16 { export AR6; }
mmr: "AR7" is mmr7=0x17 { export AR7; }
mmr: "SP" is mmr7=0x18 { export SP; }
mmr: "BK" is mmr7=0x19 { export BK; }
mmr: "BRC" is mmr7=0x1a { export BRC; }
mmr: "RSA" is mmr7=0x1b { export RSA; }
mmr: "REA" is mmr7=0x1c { export REA; }
mmr: "PMST" is mmr7=0x1d { export PMST; }
mmr: "XPC" is mmr7=0x1e { export XPC; }
mmr: mmr7 is mmr7 { export *[data]:2 mmr7; }
mmrx_r: "AR0" is mmrx=0 { export AR0; }
mmrx_r: "AR1" is mmrx=1 { export AR1; }
mmrx_r: "AR2" is mmrx=2 { export AR2; }
mmrx_r: "AR3" is mmrx=3 { export AR3; }
mmrx_r: "AR4" is mmrx=4 { export AR4; }
mmrx_r: "AR5" is mmrx=5 { export AR5; }
mmrx_r: "AR6" is mmrx=6 { export AR6; }
mmrx_r: "AR7" is mmrx=7 { export AR7; }
mmrx_r: "SP" is mmrx=8 { export SP; }
mmrx_r: "BK" is mmrx=9 { export BK; }
mmrx_r: "BRC" is mmrx=10 { export BRC; }
mmrx_r: "RSA" is mmrx=11 { export RSA; }
mmrx_r: "REA" is mmrx=12 { export REA; }
mmrx_r: "PMST" is mmrx=13 { export PMST; }
mmrx_r: "XPC" is mmrx=14 { export XPC; }
mmrx_r: "0x1f" is mmrx=15 { local a:2 = 0x1f; export *[data]:2 a; }
mmry_r: "AR0" is mmry=0 { export AR0; }
mmry_r: "AR1" is mmry=1 { export AR1; }
mmry_r: "AR2" is mmry=2 { export AR2; }
mmry_r: "AR3" is mmry=3 { export AR3; }
mmry_r: "AR4" is mmry=4 { export AR4; }
mmry_r: "AR5" is mmry=5 { export AR5; }
mmry_r: "AR6" is mmry=6 { export AR6; }
mmry_r: "AR7" is mmry=7 { export AR7; }
mmry_r: "SP" is mmry=8 { export SP; }
mmry_r: "BK" is mmry=9 { export BK; }
mmry_r: "BRC" is mmry=10 { export BRC; }
mmry_r: "RSA" is mmry=11 { export RSA; }
mmry_r: "REA" is mmry=12 { export REA; }
mmry_r: "PMST" is mmry=13 { export PMST; }
mmry_r: "XPC" is mmry=14 { export XPC; }
mmry_r: "0x1f" is mmry=15 { local a:2 = 0x1f; export *[data]:2 a; }

# condition codes
cond: "UNC" is cc8=0x00 { local c:1 = (1:1); export c; }
cond: "NBIO" is cc8=0x02 { local c:1 = (BIO == 0); export c; }
cond: "BIO" is cc8=0x03 { local c:1 = (BIO != 0); export c; }
cond: "NC" is cc8=0x08 { local c:1 = (C == 0); export c; }
cond: "NC, NBIO" is cc8=0x0a { local c:1 = (C == 0) && (BIO == 0); export c; }
cond: "NC, BIO" is cc8=0x0b { local c:1 = (C == 0) && (BIO != 0); export c; }
cond: "C" is cc8=0x0c { local c:1 = (C != 0); export c; }
cond: "C, NBIO" is cc8=0x0e { local c:1 = (C != 0) && (BIO == 0); export c; }
cond: "C, BIO" is cc8=0x0f { local c:1 = (C != 0) && (BIO != 0); export c; }
cond: "NTC" is cc8=0x20 { local c:1 = (TC == 0); export c; }
cond: "NTC, NBIO" is cc8=0x22 { local c:1 = (TC == 0) && (BIO == 0); export c; }
cond: "NTC, BIO" is cc8=0x23 { local c:1 = (TC == 0) && (BIO != 0); export c; }
cond: "NTC, NC" is cc8=0x28 { local c:1 = (TC == 0) && (C == 0); export c; }
cond: "NTC, NC, NBIO" is cc8=0x2a { local c:1 = (TC == 0) && (C == 0) && (BIO == 0); export c; }
cond: "NTC, NC, BIO" is cc8=0x2b { local c:1 = (TC == 0) && (C == 0) && (BIO != 0); export c; }
cond: "NTC, C" is cc8=0x2c { local c:1 = (TC == 0) && (C != 0); export c; }
cond: "NTC, C, NBIO" is cc8=0x2e { local c:1 = (TC == 0) && (C != 0) && (BIO == 0); export c; }
cond: "NTC, C, BIO" is cc8=0x2f { local c:1 = (TC == 0) && (C != 0) && (BIO != 0); export c; }
cond: "TC" is cc8=0x30 { local c:1 = (TC != 0); export c; }
cond: "TC, NBIO" is cc8=0x32 { local c:1 = (TC != 0) && (BIO == 0); export c; }
cond: "TC, BIO" is cc8=0x33 { local c:1 = (TC != 0) && (BIO != 0); export c; }
cond: "TC, NC" is cc8=0x38 { local c:1 = (TC != 0) && (C == 0); export c; }
cond: "TC, NC, NBIO" is cc8=0x3a { local c:1 = (TC != 0) && (C == 0) && (BIO == 0); export c; }
cond: "TC, NC, BIO" is cc8=0x3b { local c:1 = (TC != 0) && (C == 0) && (BIO != 0); export c; }
cond: "TC, C" is cc8=0x3c { local c:1 = (TC != 0) && (C != 0); export c; }
cond: "TC, C, NBIO" is cc8=0x3e { local c:1 = (TC != 0) && (C != 0) && (BIO == 0); export c; }
cond: "TC, C, BIO" is cc8=0x3f { local c:1 = (TC != 0) && (C != 0) && (BIO != 0); export c; }
cond: "AGEQ" is cc8=0x42 { local c:1 = (A s>= 0); export c; }
cond: "ALT" is cc8=0x43 { local c:1 = (A s< 0); export c; }
cond: "ANEQ" is cc8=0x44 { local c:1 = (A != 0); export c; }
cond: "AEQ" is cc8=0x45 { local c:1 = (A == 0); export c; }
cond: "AGT" is cc8=0x46 { local c:1 = (A s> 0); export c; }
cond: "ALEQ" is cc8=0x47 { local c:1 = (A s<= 0); export c; }
cond: "BGEQ" is cc8=0x4a { local c:1 = (B s>= 0); export c; }
cond: "BLT" is cc8=0x4b { local c:1 = (B s< 0); export c; }
cond: "BNEQ" is cc8=0x4c { local c:1 = (B != 0); export c; }
cond: "BEQ" is cc8=0x4d { local c:1 = (B == 0); export c; }
cond: "BGT" is cc8=0x4e { local c:1 = (B s> 0); export c; }
cond: "BLEQ" is cc8=0x4f { local c:1 = (B s<= 0); export c; }
cond: "ANOV" is cc8=0x60 { local c:1 = (OVA == 0); export c; }
cond: "AGEQ, ANOV" is cc8=0x62 { local c:1 = (A s>= 0) && (OVA == 0); export c; }
cond: "ALT, ANOV" is cc8=0x63 { local c:1 = (A s< 0) && (OVA == 0); export c; }
cond: "ANEQ, ANOV" is cc8=0x64 { local c:1 = (A != 0) && (OVA == 0); export c; }
cond: "AEQ, ANOV" is cc8=0x65 { local c:1 = (A == 0) && (OVA == 0); export c; }
cond: "AGT, ANOV" is cc8=0x66 { local c:1 = (A s> 0) && (OVA == 0); export c; }
cond: "ALEQ, ANOV" is cc8=0x67 { local c:1 = (A s<= 0) && (OVA == 0); export c; }
cond: "BNOV" is cc8=0x68 { local c:1 = (OVB == 0); export c; }
cond: "BGEQ, BNOV" is cc8=0x6a { local c:1 = (B s>= 0) && (OVB == 0); export c; }
cond: "BLT, BNOV" is cc8=0x6b { local c:1 = (B s< 0) && (OVB == 0); export c; }
cond: "BNEQ, BNOV" is cc8=0x6c { local c:1 = (B != 0) && (OVB == 0); export c; }
cond: "BEQ, BNOV" is cc8=0x6d { local c:1 = (B == 0) && (OVB == 0); export c; }
cond: "BGT, BNOV" is cc8=0x6e { local c:1 = (B s> 0) && (OVB == 0); export c; }
cond: "BLEQ, BNOV" is cc8=0x6f { local c:1 = (B s<= 0) && (OVB == 0); export c; }
cond: "AOV" is cc8=0x70 { local c:1 = (OVA != 0); export c; }
cond: "AGEQ, AOV" is cc8=0x72 { local c:1 = (A s>= 0) && (OVA != 0); export c; }
cond: "ALT, AOV" is cc8=0x73 { local c:1 = (A s< 0) && (OVA != 0); export c; }
cond: "ANEQ, AOV" is cc8=0x74 { local c:1 = (A != 0) && (OVA != 0); export c; }
cond: "AEQ, AOV" is cc8=0x75 { local c:1 = (A == 0) && (OVA != 0); export c; }
cond: "AGT, AOV" is cc8=0x76 { local c:1 = (A s> 0) && (OVA != 0); export c; }
cond: "ALEQ, AOV" is cc8=0x77 { local c:1 = (A s<= 0) && (OVA != 0); export c; }
cond: "BOV" is cc8=0x78 { local c:1 = (OVB != 0); export c; }
cond: "BGEQ, BOV" is cc8=0x7a { local c:1 = (B s>= 0) && (OVB != 0); export c; }
cond: "BLT, BOV" is cc8=0x7b { local c:1 = (B s< 0) && (OVB != 0); export c; }
cond: "BNEQ, BOV" is cc8=0x7c { local c:1 = (B != 0) && (OVB != 0); export c; }
cond: "BEQ, BOV" is cc8=0x7d { local c:1 = (B == 0) && (OVB != 0); export c; }
cond: "BGT, BOV" is cc8=0x7e { local c:1 = (B s> 0) && (OVB != 0); export c; }
cond: "BLEQ, BOV" is cc8=0x7f { local c:1 = (B s<= 0) && (OVB != 0); export c; }
cond4: "UNC" is cc4=0 { local c:1 = 1:1; export c; }
cond4: "AEQ" is cc4=5 { local c:1 = A == 0; export c; }
cond4: "ANEQ" is cc4=4 { local c:1 = A != 0; export c; }
cond4: "AGT" is cc4=6 { local c:1 = A s> 0; export c; }
cond4: "ALT" is cc4=3 { local c:1 = A s< 0; export c; }
cond4: "ALEQ" is cc4=7 { local c:1 = A s<= 0; export c; }
cond4: "AGEQ" is cc4=2 { local c:1 = A s>= 0; export c; }
cond4: "BEQ" is cc4=13 { local c:1 = B == 0; export c; }
cond4: "BNEQ" is cc4=12 { local c:1 = B != 0; export c; }
cond4: "BGT" is cc4=14 { local c:1 = B s> 0; export c; }
cond4: "BLT" is cc4=11 { local c:1 = B s< 0; export c; }
cond4: "BLEQ" is cc4=15 { local c:1 = B s<= 0; export c; }
cond4: "BGEQ" is cc4=10 { local c:1 = B s>= 0; export c; }

# SSBX / RSBX
:SSBX "ST0,0" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=0 { setStatusField(0:1, 0:1); }
:RSBX "ST0,0" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=0 { clearStatusField(0:1, 0:1); }
:SSBX "ST0,1" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=1 { setStatusField(0:1, 1:1); }
:RSBX "ST0,1" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=1 { clearStatusField(0:1, 1:1); }
:SSBX "ST0,2" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=2 { setStatusField(0:1, 2:1); }
:RSBX "ST0,2" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=2 { clearStatusField(0:1, 2:1); }
:SSBX "ST0,3" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=3 { setStatusField(0:1, 3:1); }
:RSBX "ST0,3" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=3 { clearStatusField(0:1, 3:1); }
:SSBX "ST0,4" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=4 { setStatusField(0:1, 4:1); }
:RSBX "ST0,4" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=4 { clearStatusField(0:1, 4:1); }
:SSBX "ST0,5" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=5 { setStatusField(0:1, 5:1); }
:RSBX "ST0,5" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=5 { clearStatusField(0:1, 5:1); }
:SSBX "ST0,6" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=6 { setStatusField(0:1, 6:1); }
:RSBX "ST0,6" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=6 { clearStatusField(0:1, 6:1); }
:SSBX "ST0,7" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=7 { setStatusField(0:1, 7:1); }
:RSBX "ST0,7" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=7 { clearStatusField(0:1, 7:1); }
:SSBX "ST0,8" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=8 { setStatusField(0:1, 8:1); }
:RSBX "ST0,8" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=8 { clearStatusField(0:1, 8:1); }
:SSBX "OVB" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=9 { OVB = 1; }
:RSBX "OVB" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=9 { OVB = 0; }
:SSBX "OVA" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=10 { OVA = 1; }
:RSBX "OVA" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=10 { OVA = 0; }
:SSBX "C" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=11 { C = 1; }
:RSBX "C" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=11 { C = 0; }
:SSBX "TC" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=12 { TC = 1; }
:RSBX "TC" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=12 { TC = 0; }
:SSBX "ST0,13" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=13 { setStatusField(0:1, 13:1); }
:RSBX "ST0,13" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=13 { clearStatusField(0:1, 13:1); }
:SSBX "ST0,14" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=14 { setStatusField(0:1, 14:1); }
:RSBX "ST0,14" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=14 { clearStatusField(0:1, 14:1); }
:SSBX "ST0,15" is op6=0x3d & b8=1 & nib1=0xb & nbit=0 & sbit=15 { setStatusField(0:1, 15:1); }
:RSBX "ST0,15" is op6=0x3d & b8=0 & nib1=0xb & nbit=0 & sbit=15 { clearStatusField(0:1, 15:1); }
:SSBX "ST1,0" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=0 { setStatusField(1:1, 0:1); }
:RSBX "ST1,0" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=0 { clearStatusField(1:1, 0:1); }
:SSBX "ST1,1" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=1 { setStatusField(1:1, 1:1); }
:RSBX "ST1,1" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=1 { clearStatusField(1:1, 1:1); }
:SSBX "ST1,2" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=2 { setStatusField(1:1, 2:1); }
:RSBX "ST1,2" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=2 { clearStatusField(1:1, 2:1); }
:SSBX "ST1,3" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=3 { setStatusField(1:1, 3:1); }
:RSBX "ST1,3" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=3 { clearStatusField(1:1, 3:1); }
:SSBX "ST1,4" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=4 { setStatusField(1:1, 4:1); }
:RSBX "ST1,4" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=4 { clearStatusField(1:1, 4:1); }
:SSBX "CMPT" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=5 { CMPT = 1; }
:RSBX "CMPT" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=5 { CMPT = 0; }
:SSBX "FRCT" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=6 { FRCT = 1; }
:RSBX "FRCT" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=6 { FRCT = 0; }
:SSBX "C16" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=7 { C16 = 1; }
:RSBX "C16" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=7 { C16 = 0; }
:SSBX "SXM" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=8 { SXM = 1; }
:RSBX "SXM" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=8 { SXM = 0; }
:SSBX "OVM" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=9 { OVM = 1; }
:RSBX "OVM" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=9 { OVM = 0; }
:SSBX "ST1,10" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=10 { setStatusField(1:1, 10:1); }
:RSBX "ST1,10" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=10 { clearStatusField(1:1, 10:1); }
:SSBX "INTM" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=11 { INTM = 1; }
:RSBX "INTM" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=11 { INTM = 0; }
:SSBX "HM" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=12 { HM = 1; }
:RSBX "HM" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=12 { HM = 0; }
:SSBX "XF" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=13 { XF = 1; }
:RSBX "XF" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=13 { XF = 0; }
:SSBX "CPL" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=14 [ cplmode=1; globalset(inst_next, cplmode); ] { CPL = 1; }
:RSBX "CPL" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=14 [ cplmode=0; globalset(inst_next, cplmode); ] { CPL = 0; }
:SSBX "BRAF" is op6=0x3d & b8=1 & nib1=0xb & nbit=1 & sbit=15 { BRAF = 1; }
:RSBX "BRAF" is op6=0x3d & b8=0 & nib1=0xb & nbit=1 & sbit=15 { BRAF = 0; }

# RND operand of the LD||MAC family: the accumulator opposite to dst
rnd: "B" is dst8=0 { export B; }
rnd: "A" is dst8=1 { export A; }

# CMPR condition
cmprc: "EQ"  is cc3=0 & arf { local c:1 = arf == AR0; export c; }
cmprc: "LT"  is cc3=1 & arf { local c:1 = arf < AR0; export c; }
cmprc: "GT"  is cc3=2 & arf { local c:1 = arf > AR0; export c; }
cmprc: "NEQ" is cc3=3 & arf { local c:1 = arf != AR0; export c; }

macro mul16(r, x, y) { r = sext(x) * sext(y); r = r << zext(FRCT); }
macro tshift(s) { s = (T:1 << 2) s>> 2; }

# ---- loads and stores ----
:LD Smem, dst8           is (op7=0x08 & dst8) ... & Smem      { dst8 = sext(Smem); }                          # 1000/FE00
:LD Smem, "TS", dst8     is (op7=0x0a & dst8) ... & Smem      { local v:8 = sext(Smem); local s:1 = 0; tshift(s); ashift(v, s); dst8 = v; sx40(dst8); }  # 1400
:LD Smem, "16", dst8     is (op7=0x22 & dst8) ... & Smem      { dst8 = sext(Smem) << 16; sx40(dst8); }        # 4400
:LD Xmem, shft4, dst8    is op7=0x4a & dst8 & shft4 & Xmem    { dst8 = sext(Xmem) << shft4; sx40(dst8); }     # 9400
:LD lk, shft4, dst8      is (op7=0x78 & dst8 & nib1=2 & shft4) ; lk { dst8 = sext(lk) << shft4; sx40(dst8); }  # F020/FEF0
:LD lk, "16", dst8       is (op7=0x78 & dst8 & lo8=0x62) ; lk { dst8 = sext(lk) << 16; sx40(dst8); }          # F062/FEFF
:LD "#"^k8u, dst8        is op7=0x74 & dst8 & k8u             { dst8 = k8u; }                                 # E800/FE00
:LD "#"^k5s, "ASM"       is op11=0x768 & k5s                  { ASM = k5s; }                                  # ED00/FFE0
:LD "#"^k3, "ARP"        is op13=0x1e94 & k3                  { ARP = k3; }                                   # F4A0/FFF8
:LD "#"^k9, "DP"         is op7=0x75 & k9                     { DP = k9; }                                    # EA00/FE00
:LD Smem, "T"            is (op8=0x30) ... & Smem             { T = Smem; }                                   # 3000
:LD Smem, "DP"           is (op8=0x46) ... & Smem             { DP = Smem & 0x1ff; }                          # 4600
:LD Smem, "ASM"          is (op8=0x32) ... & Smem             { ASM = Smem:1 & 0x1f; }                        # 3200
:LD src9, "ASM", dst8    is op6=0x3d & src9 & dst8 & lo8=0x82 { local v:8 = src9; local s:1 = ASM; ashift(v, s); dst8 = v; sx40(dst8); }  # F482
:LD src9, shift5, dst8   is op6=0x3d & src9 & dst8 & b7_5=2 & shift5 { local v:8 = src9; local s:1 = shift5; ashift(v, s); dst8 = v; sx40(dst8); }  # F440/FCE0
:LDU Smem, dst8          is (op7=0x09 & dst8) ... & Smem      { dst8 = zext(Smem); }                          # 1200
:LDR Smem, dst8          is (op7=0x0b & dst8) ... & Smem      { dst8 = (sext(Smem) << 16) + 0x8000; sx40(dst8); }  # 1600
:LDM mmr, dst8           is op7=0x24 & dst8 & ind=0 & mmr     { dst8 = zext(mmr); }                           # 4800
:DLD Lmem, dst8          is (op7=0x2b & dst8) ... & Lmem      { dst8 = sext(Lmem); }                          # 5600

:ST "T", Smem            is (op8=0x8c) ... & Smem             { Smem = T; }                                   # 8C00
:ST "TRN", Smem          is (op8=0x8d) ... & Smem             { Smem = TRN; }                                 # 8D00
:ST lk, Smem             is ((op8=0x76) ... & Smem) ; lk      { Smem = lk; }                                  # 7600
:STH src1, Smem          is (op7=0x41 & src1) ... & Smem      { Smem = src1(2); }                             # 8200
:STH src1, "ASM", Smem   is (op7=0x43 & src1) ... & Smem      { local v:8 = src1; local s:1 = ASM; ashift(v, s); Smem = v(2); }  # 8600
:STH src1, shft4, Xmem   is op7=0x4d & src1 & shft4 & Xmem    { local v:8 = src1 << shft4; Xmem = v(2); }     # 9A00
:STL src1, Smem          is (op7=0x40 & src1) ... & Smem      { Smem = src1:2; }                              # 8000
:STL src1, "ASM", Smem   is (op7=0x42 & src1) ... & Smem      { local v:8 = src1; local s:1 = ASM; ashift(v, s); Smem = v:2; }  # 8400
:STL src1, shft4, Xmem   is op7=0x4c & src1 & shft4 & Xmem    { local v:8 = src1 << shft4; Xmem = v:2; }      # 9800
:STLM src1, mmr          is op7=0x44 & src1 & ind=0 & mmr     { mmr = src1:2; }                               # 8800
:STM lk, mmr             is (op8=0x77 & ind=0 & mmr) ; lk     { mmr = lk; }                                   # 7700
:DST src1, Lmem          is (op7=0x27 & src1) ... & Lmem      { Lmem = src1:4; }                              # 4E00

# ---- moves ----
:MVDD Xmem, Ymem         is op8=0xe5 & Xmem & Ymem            { Ymem = Xmem; }                                # E500
:MVDK Smem, dmad         is ((op8=0x71) ... & Smem) ; dmad    { dmad = Smem; }                                # 7100
:MVDM dmad, mmr          is (op8=0x72 & ind=0 & mmr) ; dmad   { mmr = dmad; }                                 # 7200
:MVDP Smem, pmad         is ((op8=0x7d) ... & Smem) ; pmad    { pmad = Smem; }                                # 7D00
:MVKD dmad, Smem         is ((op8=0x70) ... & Smem) ; dmad    { Smem = dmad; }                                # 7000
:MVMD mmr, dmad          is (op8=0x73 & ind=0 & mmr) ; dmad   { dmad = mmr; }                                 # 7300
:MVMM mmrx_r, mmry_r     is op8=0xe7 & mmrx_r & mmry_r        { mmry_r = mmrx_r; }                            # E700
:MVPD pmad, Smem         is ((op8=0x7c) ... & Smem) ; pmad    { Smem = pmad; }                                # 7C00
:READA Smem              is (op8=0x7e) ... & Smem             { local a:2 = A:2; Smem = *[prog]:2 a; }        # 7E00
:WRITA Smem              is (op8=0x7f) ... & Smem             { local a:2 = A:2; *[prog]:2 a = Smem; }        # 7F00
:PORTR pa, Smem          is ((op8=0x74) ... & Smem) ; pa      { Smem = pa; }                                  # 7400
:PORTW Smem, pa          is ((op8=0x75) ... & Smem) ; pa      { pa = Smem; }                                  # 7500
:PSHD Smem               is (op8=0x4b) ... & Smem             { push(Smem); }                                 # 4B00
:PSHM mmr                is op8=0x4a & ind=0 & mmr            { push(mmr); }                                  # 4A00
:POPD Smem               is (op8=0x8b) ... & Smem             { local v:2 = 0; pop(v); Smem = v; }            # 8B00
:POPM mmr                is op8=0x8a & ind=0 & mmr            { local v:2 = 0; pop(v); mmr = v; }             # 8A00
:MAR Smem                is (op8=0x6d) ... & Smem             { build Smem; }                                  # 6D00 (address update only)
:DELAY Smem              is (op8=0x4d) ... & Smem             { dataDelay(Smem); }                            # 4D00
:LTD Smem                is (op8=0x4c) ... & Smem             { T = Smem; dataDelay(Smem); }                  # 4C00
:FRAME k8s               is op8=0xee & k8s                    { SP = SP + k8s; }                              # EE00

# ---- add / subtract ----
:ADD Smem, src1          is (op7=0x00 & src1) ... & Smem      { src1 = src1 + sext(Smem); sx40(src1); }       # 0000/FE00
:ADD Smem, "TS", src1    is (op7=0x02 & src1) ... & Smem      { local v:8 = sext(Smem); local s:1 = 0; tshift(s); ashift(v, s); src1 = src1 + v; sx40(src1); }  # 0400
:ADD Smem, "16", src9, dst8 is (op6=0x0f & src9 & dst8) ... & Smem { dst8 = src9 + (sext(Smem) << 16); sx40(dst8); }  # 3C00/FC00
:ADD Xmem, shft4, src1   is op7=0x48 & src1 & shft4 & Xmem    { src1 = src1 + (sext(Xmem) << shft4); sx40(src1); }  # 9000
:ADD Xmem, Ymem, dst8    is op7=0x50 & dst8 & Xmem & Ymem     { dst8 = (sext(Xmem) << 16) + (sext(Ymem) << 16); sx40(dst8); }  # A000
:ADD lk, shft4, src9, dst8 is (op6=0x3c & src9 & dst8 & nib1=0 & shft4) ; lk { dst8 = src9 + (sext(lk) << shft4); sx40(dst8); }  # F000/FCF0
:ADD lk, "16", src9, dst8 is (op6=0x3c & src9 & dst8 & lo8=0x60) ; lk { dst8 = src9 + (sext(lk) << 16); sx40(dst8); }  # F060/FCFF
:ADD src9, shift5, dst8  is op6=0x3d & src9 & dst8 & b7_5=0 & shift5 { local v:8 = src9; local s:1 = shift5; ashift(v, s); dst8 = dst8 + v; sx40(dst8); }  # F400/FCE0
:ADD src9, "ASM", dst8   is op6=0x3d & src9 & dst8 & lo8=0x80 { local v:8 = src9; local s:1 = ASM; ashift(v, s); dst8 = dst8 + v; sx40(dst8); }  # F480
:ADDC Smem, src1         is (op7=0x03 & src1) ... & Smem      { src1 = src1 + zext(Smem) + zext(C); sx40(src1); }  # 0600
:ADDS Smem, src1         is (op7=0x01 & src1) ... & Smem      { src1 = src1 + zext(Smem); sx40(src1); }       # 0200
:ADDM lk, Smem           is ((op8=0x6b) ... & Smem) ; lk      { Smem = Smem + lk; }                           # 6B00
:DADD Lmem, src9, dst8   is (op6=0x14 & src9 & dst8) ... & Lmem { dst8 = src9 + sext(Lmem); sx40(dst8); }     # 5000/FC00
:DADST Lmem, dst8        is (op7=0x2d & dst8) ... & Lmem      { dst8 = sext(Lmem) + sext(T); sx40(dst8); }    # 5A00 (C16 dual mode approximated)
:DRSUB Lmem, src1        is (op7=0x2c & src1) ... & Lmem      { src1 = sext(Lmem) - src1; sx40(src1); }       # 5800
:DSADT Lmem, dst8        is (op7=0x2f & dst8) ... & Lmem      { dst8 = sext(Lmem) - sext(T); sx40(dst8); }    # 5E00
:DSUB Lmem, src1         is (op7=0x2a & src1) ... & Lmem      { src1 = src1 - sext(Lmem); sx40(src1); }       # 5400
:DSUBT Lmem, dst8        is (op7=0x2e & dst8) ... & Lmem      { dst8 = sext(Lmem) - sext(T); sx40(dst8); }    # 5C00
:SUB Smem, src1          is (op7=0x04 & src1) ... & Smem      { src1 = src1 - sext(Smem); sx40(src1); }       # 0800
:SUB Smem, "TS", src1    is (op7=0x06 & src1) ... & Smem      { local v:8 = sext(Smem); local s:1 = 0; tshift(s); ashift(v, s); src1 = src1 - v; sx40(src1); }  # 0C00
:SUB Smem, "16", src9, dst8 is (op6=0x10 & src9 & dst8) ... & Smem { dst8 = src9 - (sext(Smem) << 16); sx40(dst8); }  # 4000/FC00
:SUB Xmem, shft4, src1   is op7=0x49 & src1 & shft4 & Xmem    { src1 = src1 - (sext(Xmem) << shft4); sx40(src1); }  # 9200
:SUB Xmem, Ymem, dst8    is op7=0x51 & dst8 & Xmem & Ymem     { dst8 = (sext(Xmem) << 16) - (sext(Ymem) << 16); sx40(dst8); }  # A200
:SUB lk, shft4, src9, dst8 is (op6=0x3c & src9 & dst8 & nib1=1 & shft4) ; lk { dst8 = src9 - (sext(lk) << shft4); sx40(dst8); }  # F010/FCF0
:SUB lk, "16", src9, dst8 is (op6=0x3c & src9 & dst8 & lo8=0x61) ; lk { dst8 = src9 - (sext(lk) << 16); sx40(dst8); }  # F061/FCFF
:SUB src9, shift5, dst8  is op6=0x3d & src9 & dst8 & b7_5=1 & shift5 { local v:8 = src9; local s:1 = shift5; ashift(v, s); dst8 = dst8 - v; sx40(dst8); }  # F420/FCE0
:SUB src9, "ASM", dst8   is op6=0x3d & src9 & dst8 & lo8=0x81 { local v:8 = src9; local s:1 = ASM; ashift(v, s); dst8 = dst8 - v; sx40(dst8); }  # F481
:SUBB Smem, src1         is (op7=0x07 & src1) ... & Smem      { src1 = src1 - zext(Smem) - zext(!C); sx40(src1); }  # 0E00
:SUBC Smem, src1         is (op7=0x0f & src1) ... & Smem      { local d:8 = src1 - (sext(Smem) << 15); local ge:1 = d s>= 0; src1 = (zext(ge) * ((d << 1) + 1)) + (zext(!ge) * (src1 << 1)); sx40(src1); }  # 1E00 (division step)
:SUBS Smem, src1         is (op7=0x05 & src1) ... & Smem      { src1 = src1 - zext(Smem); sx40(src1); }       # 0A00

# ---- logic ----
:AND Smem, src1          is (op7=0x0c & src1) ... & Smem      { src1 = src1 & zext(Smem); }                   # 1800
:AND lk, shft4, src9, dst8 is (op6=0x3c & src9 & dst8 & nib1=3 & shft4) ; lk { dst8 = src9 & (zext(lk) << shft4); }  # F030/FCF0
:AND lk, "16", src9, dst8 is (op6=0x3c & src9 & dst8 & lo8=0x63) ; lk { dst8 = src9 & (zext(lk) << 16); }       # F063
:AND src9, shift5, dst8  is op6=0x3c & src9 & dst8 & b7_5=4 & shift5 { local v:8 = src9; local s:1 = shift5; ashift(v, s); dst8 = dst8 & v; }  # F080/FCE0
:ANDM lk, Smem           is ((op8=0x68) ... & Smem) ; lk      { Smem = Smem & lk; }                           # 6800
:OR Smem, src1           is (op7=0x0d & src1) ... & Smem      { src1 = src1 | zext(Smem); }                   # 1A00
:OR lk, shft4, src9, dst8 is (op6=0x3c & src9 & dst8 & nib1=4 & shft4) ; lk { dst8 = src9 | (zext(lk) << shft4); }  # F040/FCF0
:OR lk, "16", src9, dst8 is (op6=0x3c & src9 & dst8 & lo8=0x64) ; lk { dst8 = src9 | (zext(lk) << 16); }        # F064
:OR src9, shift5, dst8   is op6=0x3c & src9 & dst8 & b7_5=5 & shift5 { local v:8 = src9; local s:1 = shift5; ashift(v, s); dst8 = dst8 | v; }  # F0A0/FCE0
:ORM lk, Smem            is ((op8=0x69) ... & Smem) ; lk      { Smem = Smem | lk; }                           # 6900
:XOR Smem, src1          is (op7=0x0e & src1) ... & Smem      { src1 = src1 ^ zext(Smem); }                   # 1C00
:XOR lk, shft4, src9, dst8 is (op6=0x3c & src9 & dst8 & nib1=5 & shft4) ; lk { dst8 = src9 ^ (zext(lk) << shft4); }  # F050/FCF0
:XOR lk, "16", src9, dst8 is (op6=0x3c & src9 & dst8 & lo8=0x65) ; lk { dst8 = src9 ^ (zext(lk) << 16); }       # F065
:XOR src9, shift5, dst8  is op6=0x3c & src9 & dst8 & b7_5=6 & shift5 { local v:8 = src9; local s:1 = shift5; ashift(v, s); dst8 = dst8 ^ v; }  # F0C0/FCE0
:XORM lk, Smem           is ((op8=0x6a) ... & Smem) ; lk      { Smem = Smem ^ lk; }                           # 6A00
:CMPL src9, dst8         is op6=0x3d & src9 & dst8 & lo8=0x93 { dst8 = ~src9; sx40(dst8); }                   # F493
:SFTA src9, shift5, dst8 is op6=0x3d & src9 & dst8 & b7_5=3 & shift5 { local v:8 = src9; local s:1 = shift5; ashift(v, s); dst8 = v; sx40(dst8); }  # F460/FCE0
:SFTL src9, shift5, dst8 is op6=0x3c & src9 & dst8 & b7_5=7 & shift5 { local v:8 = src9 & 0xffffffff; local s:1 = shift5; local amt:8 = sext(s); local pos:1 = s s>= 0; v = (zext(pos) * (v << amt)) + (zext(!pos) * (v >> (-amt))); dst8 = v & 0xffffffff; }  # F0E0/FCE0
:SFTC src1               is op7=0x7a & src1 & lo8=0x94        { local t:8 = src1 ^ (src1 << 1); local go:1 = ((t & 0x80000000) == 0) && (src1 != 0); TC = go == 0; src1 = src1 << zext(go); sx40(src1); }  # F494
:ROL src1                is op7=0x7a & src1 & lo8=0x91        { local cin:8 = zext(C); C = (src1 & 0x80000000) != 0; src1 = ((src1 << 1) | cin) & 0xffffffff; }  # F491
:ROLTC src1              is op7=0x7a & src1 & lo8=0x92        { local cin:8 = zext(TC); C = (src1 & 0x80000000) != 0; src1 = ((src1 << 1) | cin) & 0xffffffff; }  # F492
:ROR src1                is op7=0x7a & src1 & lo8=0x90        { local cin:8 = zext(C) << 31; C = (src1 & 1) != 0; src1 = ((src1 & 0xffffffff) >> 1) | cin; }  # F490

# ---- accumulator ops ----
:ABS src9, dst8          is op6=0x3d & src9 & dst8 & lo8=0x85 { local n:1 = src9 s< 0; dst8 = (zext(n) * (-src9)) + (zext(!n) * src9); }  # F485
:NEG src9, dst8          is op6=0x3d & src9 & dst8 & lo8=0x84 { dst8 = -src9; sx40(dst8); }                   # F484
:MAX dst8                is op7=0x7a & dst8 & lo8=0x86        { local b:1 = B s> A; C = b == 0; dst8 = (zext(b) * B) + (zext(!b) * A); }  # F486
:MIN dst8                is op7=0x7a & dst8 & lo8=0x87        { local b:1 = B s< A; C = b == 0; dst8 = (zext(b) * B) + (zext(!b) * A); }  # F487
:SAT src1                is op7=0x7a & src1 & lo8=0x83        { src1 = saturate(src1); }                      # F483
:EXP src1                is op7=0x7a & src1 & lo8=0x8e        { T = exponent(src1); }                         # F48E
:NORM src9, dst8         is op6=0x3d & src9 & dst8 & lo8=0x8f { dst8 = normalize(src9, T); }                  # F48F
:RND src9, dst8          is op6=0x3d & src9 & dst8 & lo8=0x9f { dst8 = src9 + 0x8000; sx40(dst8); }           # F49F

# ---- multiply / MAC ----
:MPY Smem, dst8          is (op7=0x10 & dst8) ... & Smem      { mul16(dst8, T, Smem); }                       # 2000
:MPYR Smem, dst8         is (op7=0x11 & dst8) ... & Smem      { mul16(dst8, T, Smem); dst8 = dst8 + 0x8000; } # 2200
:MPYU Smem, dst8         is (op7=0x12 & dst8) ... & Smem      { dst8 = zext(T) * zext(Smem); }                # 2400
:MPY Xmem, Ymem, dst8    is op7=0x52 & dst8 & Xmem & Ymem     { local x:2 = Xmem; T = x; mul16(dst8, x, Ymem); }  # A400
:MPY Smem, lks, dst8     is ((op7=0x31 & dst8) ... & Smem) ; lks { local x:2 = Smem; T = x; mul16(dst8, x, lks); }  # 6200
:MPY lks, dst8           is (op7=0x78 & dst8 & lo8=0x66) ; lks { mul16(dst8, T, lks); }                      # F066
:MPYA Smem               is (op8=0x31) ... & Smem             { local x:2 = Smem; T = x; local ah:2 = A(2); local p:8 = 0; mul16(p, x, ah); B = p; }  # 3100
:MPYA dst8               is op7=0x7a & dst8 & lo8=0x8c        { local ah:2 = A(2); local p:8 = 0; mul16(p, T, ah); dst8 = p; }  # F48C
:SQUR Smem, dst8         is (op7=0x13 & dst8) ... & Smem      { local x:2 = Smem; T = x; mul16(dst8, x, x); } # 2600
:SQUR "A", dst8          is op7=0x7a & dst8 & lo8=0x8d        { local h:2 = A(2); mul16(dst8, h, h); }        # F48D
:SQURA Smem, src1        is (op7=0x1c & src1) ... & Smem      { local x:2 = Smem; T = x; local p:8 = 0; mul16(p, x, x); src1 = src1 + p; sx40(src1); }  # 3800
:SQURS Smem, src1        is (op7=0x1d & src1) ... & Smem      { local x:2 = Smem; T = x; local p:8 = 0; mul16(p, x, x); src1 = src1 - p; sx40(src1); }  # 3A00
:MAC Smem, src1          is (op7=0x14 & src1) ... & Smem      { local p:8 = 0; mul16(p, T, Smem); src1 = src1 + p; sx40(src1); }  # 2800
:MACR Smem, src1         is (op7=0x15 & src1) ... & Smem      { local p:8 = 0; mul16(p, T, Smem); src1 = src1 + p + 0x8000; sx40(src1); }  # 2A00
:MAC Xmem, Ymem, src9, dst8 is op6=0x2c & src9 & dst8 & Xmem & Ymem { local x:2 = Xmem; T = x; local p:8 = 0; mul16(p, x, Ymem); dst8 = src9 + p; sx40(dst8); }  # B000
:MACR Xmem, Ymem, src9, dst8 is op6=0x2d & src9 & dst8 & Xmem & Ymem { local x:2 = Xmem; T = x; local p:8 = 0; mul16(p, x, Ymem); dst8 = src9 + p + 0x8000; sx40(dst8); }  # B400
:MAC lks, src9, dst8     is (op6=0x3c & src9 & dst8 & lo8=0x67) ; lks { local p:8 = 0; mul16(p, T, lks); dst8 = src9 + p; sx40(dst8); }  # F067
:MAC Smem, lks, src9, dst8 is ((op6=0x19 & src9 & dst8) ... & Smem) ; lks { local x:2 = Smem; T = x; local p:8 = 0; mul16(p, x, lks); dst8 = src9 + p; sx40(dst8); }  # 6400
:MACA "T", src9, dst8    is op6=0x3d & src9 & dst8 & lo8=0x88 { local ah:2 = A(2); local p:8 = 0; mul16(p, T, ah); dst8 = src9 + p; sx40(dst8); }  # F488
:MACA Smem               is (op8=0x35) ... & Smem             { local x:2 = Smem; T = x; local ah:2 = A(2); local p:8 = 0; mul16(p, x, ah); B = B + p; sx40(B); }  # 3500
:MACAR "T", src9, dst8   is op6=0x3d & src9 & dst8 & lo8=0x89 { local ah:2 = A(2); local p:8 = 0; mul16(p, T, ah); dst8 = src9 + p + 0x8000; sx40(dst8); }  # F489
:MACAR Smem              is (op8=0x37) ... & Smem             { local x:2 = Smem; T = x; local ah:2 = A(2); local p:8 = 0; mul16(p, x, ah); B = B + p + 0x8000; sx40(B); }  # 3700
:MACD Smem, pmad, src1   is ((op7=0x3d & src1) ... & Smem) ; pmad { local x:2 = Smem; T = x; local p:8 = 0; mul16(p, x, pmad); src1 = src1 + p; sx40(src1); dataDelay(x); }  # 7A00
:MACP Smem, pmad, src1   is ((op7=0x3c & src1) ... & Smem) ; pmad { local x:2 = Smem; T = x; local p:8 = 0; mul16(p, x, pmad); src1 = src1 + p; sx40(src1); }  # 7800
:MACSU Xmem, Ymem, src1  is op7=0x53 & src1 & Xmem & Ymem     { local x:2 = Xmem; T = x; local p:8 = zext(x) * sext(Ymem); src1 = src1 + p; sx40(src1); }  # A600
:MAS Smem, src1          is (op7=0x16 & src1) ... & Smem      { local p:8 = 0; mul16(p, T, Smem); src1 = src1 - p; sx40(src1); }  # 2C00
:MASR Smem, src1         is (op7=0x17 & src1) ... & Smem      { local p:8 = 0; mul16(p, T, Smem); src1 = src1 - p + 0x8000; sx40(src1); }  # 2E00
:MAS Xmem, Ymem, src9, dst8 is op6=0x2e & src9 & dst8 & Xmem & Ymem { local x:2 = Xmem; T = x; local p:8 = 0; mul16(p, x, Ymem); dst8 = src9 - p; sx40(dst8); }  # B800
:MASR Xmem, Ymem, src9, dst8 is op6=0x2f & src9 & dst8 & Xmem & Ymem { local x:2 = Xmem; T = x; local p:8 = 0; mul16(p, x, Ymem); dst8 = src9 - p + 0x8000; sx40(dst8); }  # BC00
:MASA "T", src9, dst8    is op6=0x3d & src9 & dst8 & lo8=0x8a { local ah:2 = A(2); local p:8 = 0; mul16(p, T, ah); dst8 = src9 - p; sx40(dst8); }  # F48A
:MASA Smem               is (op8=0x33) ... & Smem             { local x:2 = Smem; T = x; local ah:2 = A(2); local p:8 = 0; mul16(p, x, ah); B = B - p; sx40(B); }  # 3300
:MASAR "T", src9, dst8   is op6=0x3d & src9 & dst8 & lo8=0x8b { local ah:2 = A(2); local p:8 = 0; mul16(p, T, ah); dst8 = src9 - p + 0x8000; sx40(dst8); }  # F48B
:POLY Smem               is (op8=0x36) ... & Smem             { B = poly(Smem, A, B, T); }                    # 3600
:FIRS Xmem, Ymem, pmad   is (op8=0xe0 & Xmem & Ymem) ; pmad   { B = firs(Xmem, Ymem, pmad, A, B); }           # E000
:LMS Xmem, Ymem          is op8=0xe1 & Xmem & Ymem            { lms(Xmem, Ymem, A, B, T); }                   # E100
:SQDST Xmem, Ymem        is op8=0xe2 & Xmem & Ymem            { sqdst(Xmem, Ymem, A, B); }                    # E200
:ABDST Xmem, Ymem        is op8=0xe3 & Xmem & Ymem            { abdst(Xmem, Ymem, A, B); }                    # E300

# ---- compare / bit test ----
:BIT Xmem, bitc          is op8=0x96 & Xmem & bitc            { local s:2 = 15 - bitc; TC = ((Xmem >> s) & 1) != 0; }  # 9600
:BITF Smem, lk           is ((op8=0x61) ... & Smem) ; lk      { TC = (Smem & lk) != 0; }                      # 6100
:BITT Smem               is (op8=0x34) ... & Smem             { local s:2 = 15 - (T & 0xf); TC = ((Smem >> s) & 1) != 0; }  # 3400
:CMPM Smem, lks          is ((op8=0x60) ... & Smem) ; lks     { TC = Smem == lks; }                           # 6000
:CMPR cmprc, arf         is op6=0x3d & b7_3=0x15 & cmprc & arf { TC = cmprc; }                                # F4A8/FCF8
:CMPS src1, Smem         is (op7=0x47 & src1) ... & Smem      { compareSelect(src1, Smem, TRN, TC); }        # 8E00
:SACCD src1, Xmem, cond4 is op7=0x4f & src1 & Xmem & cond4    { if (!cond4) goto <done>; Xmem = src1(2); <done> }  # 9E00
:SRCCD Xmem, cond4       is op8=0x9d & Xmem & cond4           { if (!cond4) goto <done>; Xmem = BRC; <done> }  # 9D00
:STRCD Xmem, cond4       is op8=0x9c & Xmem & cond4           { if (!cond4) goto <done>; Xmem = T; <done> }    # 9C00

# ---- control flow ----
:B target                is op16=0xf073 ; target              { goto target; }
:BD target               is op16=0xf273 ; target              { delayslot(4); goto target; }
:BACC src1               is op7=0x7a & src1 & lo8=0xe2        { local t:2 = src1:2; goto [t]; }
:BACCD src1              is op7=0x7b & src1 & lo8=0xe2        { local t:2 = src1:2; delayslot(2); goto [t]; }
:BANZ target, SindS      is (op8=0x6c & SindS) ; target { if (SindS != 0) goto target; }
:BANZ target, SindL      is (op8=0x6c ... & SindL) ; target { if (SindL != 0) goto target; }
:BANZD target, SindS     is (op8=0x6e & SindS) ; target { local v:2 = SindS; delayslot(4); if (v != 0) goto target; }
:BANZD target, SindL     is (op8=0x6e ... & SindL) ; target { local v:2 = SindL; delayslot(4); if (v != 0) goto target; }
:BC target, cond         is (op8=0xf8 & ind=0 & cond) ; target { if (cond) goto target; }
:BCD target, cond        is (op8=0xfa & ind=0 & cond) ; target { local c:1 = cond; delayslot(4); if (c) goto target; }
:CALA src1               is op7=0x7a & src1 & lo8=0xe3        { local t:2 = src1:2; local r:2 = inst_next; push(r); call [t]; }
:CALAD src1              is op7=0x7b & src1 & lo8=0xe3        { local t:2 = src1:2; local r:2 = inst_next + 2; push(r); delayslot(2); call [t]; }
:CALL target             is op16=0xf074 ; target              { local r:2 = inst_next; push(r); call target; }
:CALLD target            is op16=0xf274 ; target              { local r:2 = inst_next + 2; push(r); delayslot(4); call target; }
:CC target, cond         is (op8=0xf9 & ind=0 & cond) ; target { if (!cond) goto inst_next; local r:2 = inst_next; push(r); call target; }
:CCD target, cond        is (op8=0xfb & ind=0 & cond) ; target { local c:1 = cond; local r:2 = inst_next + 2; delayslot(4); if (!c) goto inst_next; push(r); call target; }
:RET                     is op16=0xfc00                       { local t:2 = 0; pop(t); return [t]; }
:RETD                    is op16=0xfe00                       { local t:2 = 0; pop(t); delayslot(2); return [t]; }
:RC cond                 is op8=0xfc & cc8!=0 & cond          { if (!cond) goto inst_next; local t:2 = 0; pop(t); return [t]; }
:RCD cond                is op8=0xfe & cc8!=0 & cond          { local c:1 = cond; delayslot(2); if (!c) goto inst_next; local t:2 = 0; pop(t); return [t]; }
:RETE                    is op16=0xf4eb                       { local t:2 = 0; pop(t); INTM = 0; return [t]; }
:RETED                   is op16=0xf6eb                       { local t:2 = 0; pop(t); INTM = 0; delayslot(2); return [t]; }
:RETF                    is op16=0xf49b                       { local t:2 = 0; pop(t); INTM = 0; return [t]; }
:RETFD                   is op16=0xf69b                       { local t:2 = 0; pop(t); INTM = 0; delayslot(2); return [t]; }
:FB xtarget              is (op8=0xf8 & ind=1) ... & xtarget        { goto xtarget; }
:FBD xtarget             is (op8=0xfa & ind=1) ... & xtarget        { delayslot(4); goto xtarget; }
:FCALL xtarget           is (op8=0xf9 & ind=1) ... & xtarget        { local r:2 = inst_next; push(r); call xtarget; }
:FCALLD xtarget          is (op8=0xfb & ind=1) ... & xtarget        { local r:2 = inst_next + 2; push(r); delayslot(4); call xtarget; }
:FBACC src1              is op7=0x7a & src1 & lo8=0xe6        { local t:2 = src1:2; goto [t]; }
:FBACCD src1             is op7=0x7b & src1 & lo8=0xe6        { local t:2 = src1:2; delayslot(2); goto [t]; }
:FCALA src1              is op7=0x7a & src1 & lo8=0xe7        { local t:2 = src1:2; local r:2 = inst_next; push(r); call [t]; }
:FCALAD src1             is op7=0x7b & src1 & lo8=0xe7        { local t:2 = src1:2; local r:2 = inst_next + 2; push(r); delayslot(2); call [t]; }
:FRET                    is op16=0xf4e4                       { local t:2 = 0; pop(t); return [t]; }
:FRETD                   is op16=0xf6e4                       { local t:2 = 0; pop(t); delayslot(2); return [t]; }
:FRETE                   is op16=0xf4e5                       { local t:2 = 0; pop(t); INTM = 0; return [t]; }
:FRETED                  is op16=0xf6e5                       { local t:2 = 0; pop(t); INTM = 0; delayslot(2); return [t]; }
:INTR k5u                is op11=0x7be & k5u                  { softwareInterrupt(k5u:1); }
:TRAP k5u                is op11=0x7a6 & k5u                  { softwareInterrupt(k5u:1); }
:IDLE "1"                is op6=0x3d & idlek=0 & lo8=0xe1     { idle(1:1); }
:IDLE "2"                is op6=0x3d & idlek=1 & lo8=0xe1     { idle(2:1); }
:IDLE "3"                is op6=0x3d & idlek=2 & lo8=0xe1     { idle(3:1); }
:RESET                   is op16=0xf7e0                       { softwareReset(); }
:ESTOP                   is op16=0xf4f0                       { emulationStop(); }
:NOP                     is op16=0xf495                       { }
:RPT Smem                is (op8=0x47) ... & Smem             { RC = Smem; }
:RPT "#"^k8u             is op8=0xec & k8u                    { RC = k8u; }
:RPT lk                  is op16=0xf070 ; lk                  { RC = lk; }
:RPTB pmad               is op16=0xf072 ; pmad                { RSA = inst_next; REA = &pmad; BRAF = 1; }
:RPTBD pmad              is op16=0xf272 ; pmad                { RSA = inst_next + 2; REA = &pmad; BRAF = 1; delayslot(4); }
:RPTZ dst8, lk           is (op7=0x78 & dst8 & lo8=0x71) ; lk { dst8 = 0; RC = lk; }

# XC n, cond: execute the next n words only if cond is true
xcskip: skip is xcn=0 [ skip = inst_next + 1; ] { export *[prog]:2 skip; }
xcskip: skip is xcn=1 [ skip = inst_next + 2; ] { export *[prog]:2 skip; }
:XC "1", cond            is op6=0x3f & b8=1 & xcn=0 & cond & xcskip { if (!cond) goto xcskip; }   # FD00/FD00
:XC "2", cond            is op6=0x3f & b8=1 & xcn=1 & cond & xcskip { if (!cond) goto xcskip; }

# ---- parallel instructions (one word, two operations) ----
:LD Xmem, dst8 "||" "MAC" Ymem, rnd    is op7=0x54 & dst8 & Xmem & Ymem & rnd { local y:2 = Ymem; local p:8 = 0; mul16(p, T, y); rnd = rnd + p; sx40(rnd); dst8 = sext(Xmem) << 16; sx40(dst8); }  # A800
:LD Xmem, dst8 "||" "MACR" Ymem, rnd   is op7=0x55 & dst8 & Xmem & Ymem & rnd { local y:2 = Ymem; local p:8 = 0; mul16(p, T, y); rnd = rnd + p + 0x8000; sx40(rnd); dst8 = sext(Xmem) << 16; sx40(dst8); }  # AA00
:LD Xmem, dst8 "||" "MAS" Ymem, rnd    is op7=0x56 & dst8 & Xmem & Ymem & rnd { local y:2 = Ymem; local p:8 = 0; mul16(p, T, y); rnd = rnd - p; sx40(rnd); dst8 = sext(Xmem) << 16; sx40(dst8); }  # AC00
:LD Xmem, dst8 "||" "MASR" Ymem, rnd   is op7=0x57 & dst8 & Xmem & Ymem & rnd { local y:2 = Ymem; local p:8 = 0; mul16(p, T, y); rnd = rnd - p + 0x8000; sx40(rnd); dst8 = sext(Xmem) << 16; sx40(dst8); }  # AE00
:ST src9, Ymem "||" "ADD" Xmem, dst8   is op6=0x30 & src9 & dst8 & Xmem & Ymem { Ymem = src9(2); dst8 = dst8 + (sext(Xmem) << 16); sx40(dst8); }  # C000
:ST src9, Ymem "||" "SUB" Xmem, dst8   is op6=0x31 & src9 & dst8 & Xmem & Ymem { Ymem = src9(2); dst8 = (sext(Xmem) << 16) - dst8; sx40(dst8); }  # C400
:ST src9, Ymem "||" "LD" Xmem, dst8    is op6=0x32 & src9 & dst8 & Xmem & Ymem { Ymem = src9(2); dst8 = sext(Xmem) << 16; sx40(dst8); }  # C800
:ST src9, Ymem "||" "MPY" Xmem, dst8   is op6=0x33 & src9 & dst8 & Xmem & Ymem { Ymem = src9(2); mul16(dst8, T, Xmem); }  # CC00
:ST src9, Ymem "||" "MAC" Xmem, dst8   is op6=0x34 & src9 & dst8 & Xmem & Ymem { Ymem = src9(2); local p:8 = 0; mul16(p, T, Xmem); dst8 = dst8 + p; sx40(dst8); }  # D000
:ST src9, Ymem "||" "MACR" Xmem, dst8  is op6=0x35 & src9 & dst8 & Xmem & Ymem { Ymem = src9(2); local p:8 = 0; mul16(p, T, Xmem); dst8 = dst8 + p + 0x8000; sx40(dst8); }  # D400
:ST src9, Ymem "||" "MAS" Xmem, dst8   is op6=0x36 & src9 & dst8 & Xmem & Ymem { Ymem = src9(2); local p:8 = 0; mul16(p, T, Xmem); dst8 = dst8 - p; sx40(dst8); }  # D800
:ST src9, Ymem "||" "MASR" Xmem, dst8  is op6=0x37 & src9 & dst8 & Xmem & Ymem { Ymem = src9(2); local p:8 = 0; mul16(p, T, Xmem); dst8 = dst8 - p + 0x8000; sx40(dst8); }  # DC00
:ST src9, Ymem "||" "LD" Xmem, "T"     is op6=0x39 & src9 & b8=0 & Xmem & Ymem { Ymem = src9(2); T = Xmem; }  # E400 (bit 8 clear; E5/E7 are MVDD/MVMM)

x6f_add_00: e_shift is e_top6=3 & e_sub=0 & e_src=0 & e_dst=0 & e_shift { export *[const]:1 e_shift; }
x6f_add_01: e_shift is e_top6=3 & e_sub=0 & e_src=0 & e_dst=1 & e_shift { export *[const]:1 e_shift; }
x6f_add_10: e_shift is e_top6=3 & e_sub=0 & e_src=1 & e_dst=0 & e_shift { export *[const]:1 e_shift; }
x6f_add_11: e_shift is e_top6=3 & e_sub=0 & e_src=1 & e_dst=1 & e_shift { export *[const]:1 e_shift; }
x6f_sub_00: e_shift is e_top6=3 & e_sub=1 & e_src=0 & e_dst=0 & e_shift { export *[const]:1 e_shift; }
x6f_sub_01: e_shift is e_top6=3 & e_sub=1 & e_src=0 & e_dst=1 & e_shift { export *[const]:1 e_shift; }
x6f_sub_10: e_shift is e_top6=3 & e_sub=1 & e_src=1 & e_dst=0 & e_shift { export *[const]:1 e_shift; }
x6f_sub_11: e_shift is e_top6=3 & e_sub=1 & e_src=1 & e_dst=1 & e_shift { export *[const]:1 e_shift; }
x6f_ld_00: e_shift is e_top6=3 & e_sub=2 & e_src=0 & e_dst=0 & e_shift { export *[const]:1 e_shift; }
x6f_ld_01: e_shift is e_top6=3 & e_sub=2 & e_src=0 & e_dst=1 & e_shift { export *[const]:1 e_shift; }
x6f_sth_00: e_shift is e_top6=3 & e_sub=3 & e_src=0 & e_dst=0 & e_shift { export *[const]:1 e_shift; }
x6f_sth_01: e_shift is e_top6=3 & e_sub=3 & e_src=0 & e_dst=1 & e_shift { export *[const]:1 e_shift; }
x6f_stl_00: e_shift is e_top6=3 & e_sub=4 & e_src=0 & e_dst=0 & e_shift { export *[const]:1 e_shift; }
x6f_stl_01: e_shift is e_top6=3 & e_sub=4 & e_src=0 & e_dst=1 & e_shift { export *[const]:1 e_shift; }
:ADD SmemS, x6f_add_00, "A", "A" is (op8=0x6f & SmemS) ; x6f_add_00 { local v:8 = sext(SmemS); local sh:1 = x6f_add_00; ashift(v, sh); A = A + v; sx40(A); }
:ADD SmemL, x6f_add_00, "A", "A" is (op8=0x6f ... & SmemL) ; x6f_add_00 { local v:8 = sext(SmemL); local sh:1 = x6f_add_00; ashift(v, sh); A = A + v; sx40(A); }
:ADD SmemS, x6f_add_01, "A", "B" is (op8=0x6f & SmemS) ; x6f_add_01 { local v:8 = sext(SmemS); local sh:1 = x6f_add_01; ashift(v, sh); B = A + v; sx40(B); }
:ADD SmemL, x6f_add_01, "A", "B" is (op8=0x6f ... & SmemL) ; x6f_add_01 { local v:8 = sext(SmemL); local sh:1 = x6f_add_01; ashift(v, sh); B = A + v; sx40(B); }
:ADD SmemS, x6f_add_10, "B", "A" is (op8=0x6f & SmemS) ; x6f_add_10 { local v:8 = sext(SmemS); local sh:1 = x6f_add_10; ashift(v, sh); A = B + v; sx40(A); }
:ADD SmemL, x6f_add_10, "B", "A" is (op8=0x6f ... & SmemL) ; x6f_add_10 { local v:8 = sext(SmemL); local sh:1 = x6f_add_10; ashift(v, sh); A = B + v; sx40(A); }
:ADD SmemS, x6f_add_11, "B", "B" is (op8=0x6f & SmemS) ; x6f_add_11 { local v:8 = sext(SmemS); local sh:1 = x6f_add_11; ashift(v, sh); B = B + v; sx40(B); }
:ADD SmemL, x6f_add_11, "B", "B" is (op8=0x6f ... & SmemL) ; x6f_add_11 { local v:8 = sext(SmemL); local sh:1 = x6f_add_11; ashift(v, sh); B = B + v; sx40(B); }
:SUB SmemS, x6f_sub_00, "A", "A" is (op8=0x6f & SmemS) ; x6f_sub_00 { local v:8 = sext(SmemS); local sh:1 = x6f_sub_00; ashift(v, sh); A = A - v; sx40(A); }
:SUB SmemL, x6f_sub_00, "A", "A" is (op8=0x6f ... & SmemL) ; x6f_sub_00 { local v:8 = sext(SmemL); local sh:1 = x6f_sub_00; ashift(v, sh); A = A - v; sx40(A); }
:SUB SmemS, x6f_sub_01, "A", "B" is (op8=0x6f & SmemS) ; x6f_sub_01 { local v:8 = sext(SmemS); local sh:1 = x6f_sub_01; ashift(v, sh); B = A - v; sx40(B); }
:SUB SmemL, x6f_sub_01, "A", "B" is (op8=0x6f ... & SmemL) ; x6f_sub_01 { local v:8 = sext(SmemL); local sh:1 = x6f_sub_01; ashift(v, sh); B = A - v; sx40(B); }
:SUB SmemS, x6f_sub_10, "B", "A" is (op8=0x6f & SmemS) ; x6f_sub_10 { local v:8 = sext(SmemS); local sh:1 = x6f_sub_10; ashift(v, sh); A = B - v; sx40(A); }
:SUB SmemL, x6f_sub_10, "B", "A" is (op8=0x6f ... & SmemL) ; x6f_sub_10 { local v:8 = sext(SmemL); local sh:1 = x6f_sub_10; ashift(v, sh); A = B - v; sx40(A); }
:SUB SmemS, x6f_sub_11, "B", "B" is (op8=0x6f & SmemS) ; x6f_sub_11 { local v:8 = sext(SmemS); local sh:1 = x6f_sub_11; ashift(v, sh); B = B - v; sx40(B); }
:SUB SmemL, x6f_sub_11, "B", "B" is (op8=0x6f ... & SmemL) ; x6f_sub_11 { local v:8 = sext(SmemL); local sh:1 = x6f_sub_11; ashift(v, sh); B = B - v; sx40(B); }
:LD SmemS, x6f_ld_00, "A" is (op8=0x6f & SmemS) ; x6f_ld_00 { local v:8 = sext(SmemS); local sh:1 = x6f_ld_00; ashift(v, sh); A = v; sx40(A); }
:LD SmemL, x6f_ld_00, "A" is (op8=0x6f ... & SmemL) ; x6f_ld_00 { local v:8 = sext(SmemL); local sh:1 = x6f_ld_00; ashift(v, sh); A = v; sx40(A); }
:LD SmemS, x6f_ld_01, "B" is (op8=0x6f & SmemS) ; x6f_ld_01 { local v:8 = sext(SmemS); local sh:1 = x6f_ld_01; ashift(v, sh); B = v; sx40(B); }
:LD SmemL, x6f_ld_01, "B" is (op8=0x6f ... & SmemL) ; x6f_ld_01 { local v:8 = sext(SmemL); local sh:1 = x6f_ld_01; ashift(v, sh); B = v; sx40(B); }
:STH "A", x6f_sth_00, SmemS is (op8=0x6f & SmemS) ; x6f_sth_00 { local v:8 = A; local sh:1 = x6f_sth_00; ashift(v, sh); SmemS = v(2); }
:STH "A", x6f_sth_00, SmemL is (op8=0x6f ... & SmemL) ; x6f_sth_00 { local v:8 = A; local sh:1 = x6f_sth_00; ashift(v, sh); SmemL = v(2); }
:STH "B", x6f_sth_01, SmemS is (op8=0x6f & SmemS) ; x6f_sth_01 { local v:8 = B; local sh:1 = x6f_sth_01; ashift(v, sh); SmemS = v(2); }
:STH "B", x6f_sth_01, SmemL is (op8=0x6f ... & SmemL) ; x6f_sth_01 { local v:8 = B; local sh:1 = x6f_sth_01; ashift(v, sh); SmemL = v(2); }
:STL "A", x6f_stl_00, SmemS is (op8=0x6f & SmemS) ; x6f_stl_00 { local v:8 = A; local sh:1 = x6f_stl_00; ashift(v, sh); SmemS = v:2; }
:STL "A", x6f_stl_00, SmemL is (op8=0x6f ... & SmemL) ; x6f_stl_00 { local v:8 = A; local sh:1 = x6f_stl_00; ashift(v, sh); SmemL = v:2; }
:STL "B", x6f_stl_01, SmemS is (op8=0x6f & SmemS) ; x6f_stl_01 { local v:8 = B; local sh:1 = x6f_stl_01; ashift(v, sh); SmemS = v:2; }
:STL "B", x6f_stl_01, SmemL is (op8=0x6f ... & SmemL) ; x6f_stl_01 { local v:8 = B; local sh:1 = x6f_stl_01; ashift(v, sh); SmemL = v:2; }

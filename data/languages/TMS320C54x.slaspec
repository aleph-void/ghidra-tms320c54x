# TMS320C54x SLEIGH specification -- generated by make_slaspec.py, do not edit by hand.

define endian=big;
define alignment=2;

define space prog     type=ram_space      size=2 wordsize=2 default;
define space data     type=ram_space      size=2 wordsize=2;
define space io       type=ram_space      size=2 wordsize=2;
define space register type=register_space size=2;

define register offset=0x00 size=2 [ PC SP T TRN AR0 AR1 AR2 AR3 AR4 AR5 AR6 AR7
                                     BK BRC RSA REA PMST XPC IMR IFR ST0 ST1 DP RC ];
define register offset=0x40 size=8 [ A B ];
define register offset=0x42 size=2 [ AG ];
define register offset=0x44 size=2 [ AH AL ];
define register offset=0x4A size=2 [ BG ];
define register offset=0x4C size=2 [ BH BL ];
define register offset=0x80 size=1 [ TC C OVA OVB SXM OVM C16 FRCT CPL INTM XF BRAF CMPT HM ARP ASM BIO ];   # BIO: the BIO input pin
define register offset=0x100 size=4 [ contextreg ];

define context contextreg
  cplmode = (0,0)      # 1: direct addressing is SP-relative (ST1.CPL=1)
;

define token instr(16)
  op16 = (0,15)
  op13 = (3,15)
  op12 = (4,15)
  op11 = (5,15)
  op10 = (6,15)
  op8  = (8,15)
  op7  = (9,15)
  op6  = (10,15)
  op6b = (0,5)
  b7_0 = (0,7)
  lo8  = (0,7)
  b5_4 = (4,5)
  nib1 = (4,7)
  b7_5 = (5,7)
  b7_3 = (3,7)
  b8   = (8,8)
  ind  = (7,7)
  mod  = (3,6)
  arf  = (0,2)
  dma  = (0,6)
  mmr7 = (0,6)
  src9 = (9,9)
  dst8 = (8,8)
  src1 = (8,8)
  shift5 = (0,4) signed
  shft4 = (0,3)
  k8s  = (0,7) signed
  k8u  = (0,7)
  k9   = (0,8)
  k5s  = (0,4) signed
  k5u  = (0,4)
  k3   = (0,2)
  xmod = (6,7)
  xar  = (4,5)
  ymod = (2,3)
  yar  = (0,1)
  cc8  = (0,7)
  cc4  = (0,3)
  cc3  = (8,9)
  nbit = (9,9)
  sbit = (0,3)
  xcn  = (9,9)
  mmrx = (4,7)
  mmry = (0,3)
  idlek = (8,9)
  bitc = (0,3)
  xpage = (0,6)
;

define token ext(16)
  ext16  = (0,15)
  ext16s = (0,15) signed
  e_top6 = (10,15)
  e_src  = (9,9)
  e_dst  = (8,8)
  e_sub  = (5,7)
  e_shift = (0,4) signed
;

attach variables [ arf ] [ AR0 AR1 AR2 AR3 AR4 AR5 AR6 AR7 ];
attach variables [ xar yar ] [ AR2 AR3 AR4 AR5 ];
attach variables [ src9 dst8 src1 e_src e_dst ] [ A B ];

define pcodeop firs;
define pcodeop lms;
define pcodeop abdst;
define pcodeop sqdst;
define pcodeop poly;
define pcodeop exponent;
define pcodeop normalize;
define pcodeop roundAcc;
define pcodeop saturate;
define pcodeop idle;
define pcodeop softwareInterrupt;
define pcodeop softwareReset;
define pcodeop emulationStop;
define pcodeop dataDelay;
define pcodeop compareSelect;
define pcodeop setStatusField;
define pcodeop clearStatusField;
define pcodeop farAddress;

# ---- helpers ---------------------------------------------------------------------------

macro sx40(r) { r = (r << 24) s>> 24; }
macro ashift(v, s) {
  local pos:1 = s s>= 0;
  local amt:8 = sext(s);
  v = (zext(pos) * (v << amt)) + (zext(!pos) * (v s>> (-amt)));
}
macro push(v) { SP = SP - 1; *[data]:2 SP = v; }
macro pop(v)  { v = *[data]:2 SP; SP = SP + 1; }

macro ldx(d, s)   { local z:8 = zext(s); local e:8 = sext(s); d = z + (zext(SXM) * (e - z)); }     # 16-bit operand: SXM decides
macro ldx32(d, s) { local z:8 = zext(s); local e:8 = sext(s); d = z + (zext(SXM) * (e - z)); }
# accumulator result r (any 64-bit value): wrap to 40 bits, set the overflow flag, saturate to 32 bits when OVM=1
macro finish(d, r, ov) {
  local w40:8 = (r << 24) s>> 24;
  local w32:8 = (r << 32) s>> 32;
  local o40:1 = w40 != r;
  local o32:1 = w32 != r;
  local sat:1 = (OVM != 0) && o32;
  local o:1 = ((OVM == 0) && o40) || sat;
  local neg:8 = zext(r s< 0);
  local lim:8 = 0x7fffffff ^ (0 - neg);
  local s8:8 = zext(sat);
  d = (s8 * lim) + ((1 - s8) * w40);
  ov = ov | o;
}
macro cadd(x, y)  { C = (((x & 0xffffffff) + (y & 0xffffffff)) >> 32) != 0; }
macro csub(x, y)  { C = (x & 0xffffffff) >= (y & 0xffffffff); }
macro caddk(x, y) { C = C | ((((x & 0xffffffff) + (y & 0xffffffff)) >> 32) != 0); }      # the "<< 16" forms only set C
macro csubk(x, y) { C = C & ((x & 0xffffffff) >= (y & 0xffffffff)); }                    # ... and only clear it

# ST0 / ST1 are assembled from and split into the individual flag registers (SPRU131G figures 4-1, 4-2)
macro st0_get(v) {
  local a:2 = zext(ARP); local t:2 = zext(TC); local c:2 = zext(C); local o1:2 = zext(OVA); local o2:2 = zext(OVB);
  v = (a << 13) | (t << 12) | (c << 11) | (o1 << 10) | (o2 << 9) | (DP & 0x1ff);
}
macro st0_set(v) {
  local x:2 = v >> 13; ARP = x:1;
  TC = ((v >> 12) & 1) != 0; C = ((v >> 11) & 1) != 0; OVA = ((v >> 10) & 1) != 0; OVB = ((v >> 9) & 1) != 0;
  DP = v & 0x1ff;
}
macro st1_get(v) {
  local b:2 = zext(BRAF); local p:2 = zext(CPL); local f:2 = zext(XF); local h:2 = zext(HM); local i:2 = zext(INTM);
  local m:2 = zext(OVM); local sx:2 = zext(SXM); local c1:2 = zext(C16); local fr:2 = zext(FRCT); local cm:2 = zext(CMPT);
  local am:2 = zext(ASM) & 0x1f;
  v = (b << 15) | (p << 14) | (f << 13) | (h << 12) | (i << 11) | (m << 9) | (sx << 8) | (c1 << 7) | (fr << 6) | (cm << 5) | am;
}
macro st1_set(v) {
  BRAF = ((v >> 15) & 1) != 0; CPL = ((v >> 14) & 1) != 0; XF = ((v >> 13) & 1) != 0; HM = ((v >> 12) & 1) != 0;
  INTM = ((v >> 11) & 1) != 0; OVM = ((v >> 9) & 1) != 0; SXM = ((v >> 8) & 1) != 0; C16 = ((v >> 7) & 1) != 0;
  FRCT = ((v >> 6) & 1) != 0; CMPT = ((v >> 5) & 1) != 0;
  local w:2 = ((v & 0x1f) << 11) s>> 11; ASM = w:1;
}
# value stored by the parallel ST instructions: (src << (ASM - 16)), low 16 bits
macro stsh(out, src) {
  local k:8 = sext(ASM);
  local n:8 = 16 - k;
  local x:8 = src;
  local xl:8 = x & 0xffffffffff;
  local sx8:8 = zext(SXM);
  local r:8 = (sx8 * (x s>> n)) + ((1 - sx8) * (xl >> n));
  out = r:2;
}
macro brev16(v) {   # reverse the bit order of a 16-bit value
  v = ((v >> 1) & 0x5555) | ((v & 0x5555) << 1);
  v = ((v >> 2) & 0x3333) | ((v & 0x3333) << 2);
  v = ((v >> 4) & 0x0f0f) | ((v & 0x0f0f) << 4);
  v = (v >> 8) | (v << 8);
}
# ARx +/- AR0 with the carry propagating from the MSB to the LSB (SPRU131G 5.5.3.5)
macro bradd(r, y) { local a:2 = r; local b:2 = y; brev16(a); brev16(b); a = a + b; brev16(a); r = a; }
macro brsub(r, y) { local a:2 = r; local b:2 = y; brev16(a); brev16(b); a = a - b; brev16(a); r = a; }
# circular addressing (SPRU131G 5.5.3.4): N = smallest integer with 2^N > BK, index = low N bits of ARx;
# BK = 0: a plain addition (SPRU172C ST||ADD example: *AR5+0% with BK=0 adds AR0)
macro circadd(r, st) {
  local m:2 = BK;
  m = m | (m >> 1); m = m | (m >> 2); m = m | (m >> 4); m = m | (m >> 8);
  local idx:4 = zext(r & m);
  local sum:4 = idx + sext(st);
  local bk4:4 = zext(BK);
  local ge:4 = zext(sum s>= bk4);
  local lt:4 = zext(sum s< 0);
  local nidx:4 = sum - (ge * bk4) + (lt * bk4);
  local res:2 = (r & ~m) | (nidx:2 & m);
  local nz:2 = zext(BK != 0);
  r = ((r + st) * (1 - nz)) + (res * nz);      # BK = 0: no circular modification, a plain addition
}


# overflow flag of the accumulator named by a field (empty display text)
ovd:  "" is dst8=0 { export OVA; }
ovd:  "" is dst8=1 { export OVB; }
ovs1: "" is src1=0 { export OVA; }
ovs1: "" is src1=1 { export OVB; }
dsto: "" is dst8=0 { export B; }
dsto: "" is dst8=1 { export A; }
ovr:  "" is dst8=0 { export OVB; }
ovr:  "" is dst8=1 { export OVA; }

# Operands: direct (DP or SP relative), indirect, long-offset indirect and absolute; generated by gen_addressing()
SmemS: "@"^dma          is ind=0 & dma & cplmode=0 { local a:2 = (DP << 7) | dma; export *[data]:2 a; }
SmemS: "*SP("^dma^")"   is ind=0 & dma & cplmode=1 { local a:2 = SP + dma; export *[data]:2 a; }
SmemS: "*"^arf is ind=1 & mod=0 & arf {  export *[data]:2 arf; }
SmemS: "*"^arf^"-" is ind=1 & mod=1 & arf { local a:2 = arf; arf = arf - 1; export *[data]:2 a; }
SmemS: "*"^arf^"+" is ind=1 & mod=2 & arf { local a:2 = arf; arf = arf + 1; export *[data]:2 a; }
SmemS: "*+"^arf is ind=1 & mod=3 & arf { arf = arf + 1; export *[data]:2 arf; }
SmemS: "*"^arf^"-0B" is ind=1 & mod=4 & arf { local a:2 = arf; brsub(arf, AR0); export *[data]:2 a; }
SmemS: "*"^arf^"-0" is ind=1 & mod=5 & arf { local a:2 = arf; arf = arf - AR0; export *[data]:2 a; }
SmemS: "*"^arf^"+0" is ind=1 & mod=6 & arf { local a:2 = arf; arf = arf + AR0; export *[data]:2 a; }
SmemS: "*"^arf^"+0B" is ind=1 & mod=7 & arf { local a:2 = arf; bradd(arf, AR0); export *[data]:2 a; }
SmemS: "*"^arf^"-%" is ind=1 & mod=8 & arf { local a:2 = arf; local st:2 = -1; circadd(arf, st); export *[data]:2 a; }
SmemS: "*"^arf^"-0%" is ind=1 & mod=9 & arf { local a:2 = arf; local st:2 = 0 - AR0; circadd(arf, st); export *[data]:2 a; }
SmemS: "*"^arf^"+%" is ind=1 & mod=10 & arf { local a:2 = arf; local st:2 = 1; circadd(arf, st); export *[data]:2 a; }
SmemS: "*"^arf^"+0%" is ind=1 & mod=11 & arf { local a:2 = arf; local st:2 = AR0; circadd(arf, st); export *[data]:2 a; }
SmemL: "*"^arf^"("^ext16^")"   is (ind=1 & mod=12 & arf) ; ext16 { local a:2 = arf + ext16; export *[data]:2 a; }
SmemL: "*+"^arf^"("^ext16^")"  is (ind=1 & mod=13 & arf) ; ext16 { arf = arf + ext16; export *[data]:2 arf; }
SmemL: "*+"^arf^"("^ext16^")%" is (ind=1 & mod=14 & arf) ; ext16 { local st:2 = ext16; circadd(arf, st); export *[data]:2 arf; }
SmemL: "*("^ext16^")"          is (ind=1 & mod=15) ; ext16 { export *[data]:2 ext16; }
Smem: SmemS is SmemS { export SmemS; }
Smem: SmemL is SmemL { export SmemL; }
LmemS: "@"^dma          is ind=0 & dma & cplmode=0 { local a:2 = (DP << 7) | dma; export *[data]:4 a; }
LmemS: "*SP("^dma^")"   is ind=0 & dma & cplmode=1 { local a:2 = SP + dma; export *[data]:4 a; }
LmemS: "*"^arf is ind=1 & mod=0 & arf {  export *[data]:4 arf; }
LmemS: "*"^arf^"-" is ind=1 & mod=1 & arf { local a:2 = arf; arf = arf - 2; export *[data]:4 a; }
LmemS: "*"^arf^"+" is ind=1 & mod=2 & arf { local a:2 = arf; arf = arf + 2; export *[data]:4 a; }
LmemS: "*+"^arf is ind=1 & mod=3 & arf { arf = arf + 2; export *[data]:4 arf; }
LmemS: "*"^arf^"-0B" is ind=1 & mod=4 & arf { local a:2 = arf; brsub(arf, AR0); export *[data]:4 a; }
LmemS: "*"^arf^"-0" is ind=1 & mod=5 & arf { local a:2 = arf; arf = arf - AR0; export *[data]:4 a; }
LmemS: "*"^arf^"+0" is ind=1 & mod=6 & arf { local a:2 = arf; arf = arf + AR0; export *[data]:4 a; }
LmemS: "*"^arf^"+0B" is ind=1 & mod=7 & arf { local a:2 = arf; bradd(arf, AR0); export *[data]:4 a; }
LmemS: "*"^arf^"-%" is ind=1 & mod=8 & arf { local a:2 = arf; local st:2 = -2; circadd(arf, st); export *[data]:4 a; }
LmemS: "*"^arf^"-0%" is ind=1 & mod=9 & arf { local a:2 = arf; local st:2 = 0 - AR0; circadd(arf, st); export *[data]:4 a; }
LmemS: "*"^arf^"+%" is ind=1 & mod=10 & arf { local a:2 = arf; local st:2 = 2; circadd(arf, st); export *[data]:4 a; }
LmemS: "*"^arf^"+0%" is ind=1 & mod=11 & arf { local a:2 = arf; local st:2 = AR0; circadd(arf, st); export *[data]:4 a; }
LmemL: "*"^arf^"("^ext16^")"   is (ind=1 & mod=12 & arf) ; ext16 { local a:2 = arf + ext16; export *[data]:4 a; }
LmemL: "*+"^arf^"("^ext16^")"  is (ind=1 & mod=13 & arf) ; ext16 { arf = arf + ext16; export *[data]:4 arf; }
LmemL: "*+"^arf^"("^ext16^")%" is (ind=1 & mod=14 & arf) ; ext16 { local st:2 = ext16; circadd(arf, st); export *[data]:4 arf; }
LmemL: "*("^ext16^")"          is (ind=1 & mod=15) ; ext16 { export *[data]:4 ext16; }
Lmem: LmemS is LmemS { export LmemS; }
Lmem: LmemL is LmemL { export LmemL; }
SindS: "*"^arf is ind=1 & mod=0 & arf { local v:2 = arf;  export v; }
SindS: "*"^arf^"-" is ind=1 & mod=1 & arf { local v:2 = arf; arf = arf - 1; export v; }
SindS: "*"^arf^"+" is ind=1 & mod=2 & arf { local v:2 = arf; arf = arf + 1; export v; }
SindS: "*+"^arf is ind=1 & mod=3 & arf { local v:2 = arf; arf = arf + 1; export v; }
SindS: "*"^arf^"-0B" is ind=1 & mod=4 & arf { local v:2 = arf; brsub(arf, AR0); export v; }
SindS: "*"^arf^"-0" is ind=1 & mod=5 & arf { local v:2 = arf; arf = arf - AR0; export v; }
SindS: "*"^arf^"+0" is ind=1 & mod=6 & arf { local v:2 = arf; arf = arf + AR0; export v; }
SindS: "*"^arf^"+0B" is ind=1 & mod=7 & arf { local v:2 = arf; bradd(arf, AR0); export v; }
SindS: "*"^arf^"-%" is ind=1 & mod=8 & arf { local v:2 = arf; local st:2 = -1; circadd(arf, st); export v; }
SindS: "*"^arf^"-0%" is ind=1 & mod=9 & arf { local v:2 = arf; local st:2 = 0 - AR0; circadd(arf, st); export v; }
SindS: "*"^arf^"+%" is ind=1 & mod=10 & arf { local v:2 = arf; local st:2 = 1; circadd(arf, st); export v; }
SindS: "*"^arf^"+0%" is ind=1 & mod=11 & arf { local v:2 = arf; local st:2 = AR0; circadd(arf, st); export v; }
SindL: "*"^arf^"("^ext16s^")"   is (ind=1 & mod=12 & arf) ; ext16s { local v:2 = arf; export v; }
SindL: "*+"^arf^"("^ext16s^")"  is (ind=1 & mod=13 & arf) ; ext16s { local v:2 = arf; arf = arf + ext16s; export v; }
SindL: "*+"^arf^"("^ext16s^")%" is (ind=1 & mod=14 & arf) ; ext16s { local v:2 = arf; local st:2 = ext16s; circadd(arf, st); export v; }
Xmem: "*"^xar          is xmod=0 & xar { export *[data]:2 xar; }
Xmem: "*"^xar^"-"      is xmod=1 & xar { local a:2 = xar; xar = xar - 1; export *[data]:2 a; }
Xmem: "*"^xar^"+"      is xmod=2 & xar { local a:2 = xar; xar = xar + 1; export *[data]:2 a; }
Xmem: "*"^xar^"+0%"    is xmod=3 & xar { local a:2 = xar; local st:2 = AR0; circadd(xar, st); export *[data]:2 a; }
Ymem: "*"^yar          is ymod=0 & yar { export *[data]:2 yar; }
Ymem: "*"^yar^"-"      is ymod=1 & yar { local a:2 = yar; yar = yar - 1; export *[data]:2 a; }
Ymem: "*"^yar^"+"      is ymod=2 & yar { local a:2 = yar; yar = yar + 1; export *[data]:2 a; }
Ymem: "*"^yar^"+0%"    is ymod=3 & yar { local a:2 = yar; local st:2 = AR0; circadd(yar, st); export *[data]:2 a; }
mmrS: "*"^arf is ind=1 & mod=0 & arf {  local mm:2 = arf & 0x7f; export *[data]:2 mm; }
mmrS: "*"^arf^"-" is ind=1 & mod=1 & arf { local a:2 = arf; arf = arf - 1; local mm:2 = a & 0x7f; export *[data]:2 mm; }
mmrS: "*"^arf^"+" is ind=1 & mod=2 & arf { local a:2 = arf; arf = arf + 1; local mm:2 = a & 0x7f; export *[data]:2 mm; }
mmrS: "*+"^arf is ind=1 & mod=3 & arf { arf = arf + 1; local mm:2 = arf & 0x7f; export *[data]:2 mm; }
mmrS: "*"^arf^"-0B" is ind=1 & mod=4 & arf { local a:2 = arf; brsub(arf, AR0); local mm:2 = a & 0x7f; export *[data]:2 mm; }
mmrS: "*"^arf^"-0" is ind=1 & mod=5 & arf { local a:2 = arf; arf = arf - AR0; local mm:2 = a & 0x7f; export *[data]:2 mm; }
mmrS: "*"^arf^"+0" is ind=1 & mod=6 & arf { local a:2 = arf; arf = arf + AR0; local mm:2 = a & 0x7f; export *[data]:2 mm; }
mmrS: "*"^arf^"+0B" is ind=1 & mod=7 & arf { local a:2 = arf; bradd(arf, AR0); local mm:2 = a & 0x7f; export *[data]:2 mm; }
mmrS: "*"^arf^"-%" is ind=1 & mod=8 & arf { local a:2 = arf; local st:2 = -1; circadd(arf, st); local mm:2 = a & 0x7f; export *[data]:2 mm; }
mmrS: "*"^arf^"-0%" is ind=1 & mod=9 & arf { local a:2 = arf; local st:2 = 0 - AR0; circadd(arf, st); local mm:2 = a & 0x7f; export *[data]:2 mm; }
mmrS: "*"^arf^"+%" is ind=1 & mod=10 & arf { local a:2 = arf; local st:2 = 1; circadd(arf, st); local mm:2 = a & 0x7f; export *[data]:2 mm; }
mmrS: "*"^arf^"+0%" is ind=1 & mod=11 & arf { local a:2 = arf; local st:2 = AR0; circadd(arf, st); local mm:2 = a & 0x7f; export *[data]:2 mm; }

# Immediates and addresses in the extension word
lk:   "#"^ext16  is ext16  { export *[const]:2 ext16; }
lks:  "#"^ext16s is ext16s { export *[const]:2 ext16s; }
dmad: ext16      is ext16  { export *[data]:2 ext16; }
pmad: ext16      is ext16  { export *[prog]:2 ext16; }
pa:   ext16      is ext16  { export *[io]:2 ext16; }
target: ext16    is ext16 { export *[prog]:2 ext16; }
# far: the 7-bit page (bits 0-6 of the opcode word) goes to XPC; program space is addressed with the 16-bit part
xtarget: xpage^":"^ext16 is xpage ; ext16 { export *[prog]:2 ext16; }

# MMR: memory-mapped register operand (CPU registers map to Ghidra registers)
mmr: "IMR" is ind=0 & mmr7=0x00 { export IMR; }
mmr: "IFR" is ind=0 & mmr7=0x01 { export IFR; }
mmr: "AL" is ind=0 & mmr7=0x08 { export AL; }
mmr: "AH" is ind=0 & mmr7=0x09 { export AH; }
mmr: "AG" is ind=0 & mmr7=0x0a { export AG; }
mmr: "BL" is ind=0 & mmr7=0x0b { export BL; }
mmr: "BH" is ind=0 & mmr7=0x0c { export BH; }
mmr: "BG" is ind=0 & mmr7=0x0d { export BG; }
mmr: "T" is ind=0 & mmr7=0x0e { export T; }
mmr: "TRN" is ind=0 & mmr7=0x0f { export TRN; }
mmr: "AR0" is ind=0 & mmr7=0x10 { export AR0; }
mmr: "AR1" is ind=0 & mmr7=0x11 { export AR1; }
mmr: "AR2" is ind=0 & mmr7=0x12 { export AR2; }
mmr: "AR3" is ind=0 & mmr7=0x13 { export AR3; }
mmr: "AR4" is ind=0 & mmr7=0x14 { export AR4; }
mmr: "AR5" is ind=0 & mmr7=0x15 { export AR5; }
mmr: "AR6" is ind=0 & mmr7=0x16 { export AR6; }
mmr: "AR7" is ind=0 & mmr7=0x17 { export AR7; }
mmr: "SP" is ind=0 & mmr7=0x18 { export SP; }
mmr: "BK" is ind=0 & mmr7=0x19 { export BK; }
mmr: "BRC" is ind=0 & mmr7=0x1a { export BRC; }
mmr: "RSA" is ind=0 & mmr7=0x1b { export RSA; }
mmr: "REA" is ind=0 & mmr7=0x1c { export REA; }
mmr: "PMST" is ind=0 & mmr7=0x1d { export PMST; }
mmr: "XPC" is ind=0 & mmr7=0x1e { export XPC; }

<?xml version="1.0" encoding="UTF-8"?>

<language_definitions>
  <!--
    TI TMS320C54x DSP. Instruction encodings from the GNU binutils opcode table;
    TMS320C54x.slaspec is generated by make_slaspec.py.
  -->
  <language processor="TMS320C54x"
            endian="big"
            size="16"
            variant="default"
            version="1.0"
            slafile="TMS320C54x.sla"
            processorspec="TMS320C54x.pspec"
            id="TMS320C54x:BE:16:default">
    <description>TI TMS320C54x 16-bit fixed-point DSP (word-addressed program, data and I/O spaces)</description>
    <compiler name="default" spec="TMS320C54x.cspec" id="default"/>
    <external_name tool="gnu" name="tic54x"/>
  </language>
</language_definitions>
